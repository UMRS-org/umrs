# =============================================================================
# Environment Configuration for Slurm Development Demo
# =============================================================================

# -----------------------------------------------------------------------------
# Model Configuration
# -----------------------------------------------------------------------------
# Path to model directory on the host (mounted into compute container)
MODEL_PATH=./rivault/models

# -----------------------------------------------------------------------------
# Slurm Configuration
# -----------------------------------------------------------------------------
SLURM_PARTITION=dev
SLURM_TIME=01:00:00
SLURM_GPUS=1
SLURM_CPUS=4
SLURM_MEM=8G
SLURMD_OPTIONS=-D --conf-server ai-login

# -----------------------------------------------------------------------------
# Rivault / LiteLLM Configuration (Slurm-launched embedding model)
# -----------------------------------------------------------------------------
# Port exposed by Rivault's NGINX->LiteLLM on the compute node
NGINX_LITELLM_DOCKER_PORT=11434
LITELLM_MASTER_KEY=sk-demo-dev

# Port used by rivault.py SSH tunnel (must match NGINX_LITELLM_DOCKER_PORT)
RIVAULT_REMOTE_PORT=11434

# vLLM model path inside compute container
VLLM_PATH_TO_HUGGINGFACE=/models

# -----------------------------------------------------------------------------
# Always-On LLM Configuration (profile: llm)
# -----------------------------------------------------------------------------
LLM_MODEL_PATH=./rivault/models
LLM_LITELLM_MASTER_KEY=sk-llm-demo
LLM_LITELLM_SALT_KEY=llm-salt-key-demo
LLM_GPU_MEM_UTIL=0.85
VLLM_DOCKER_TAG=latest
LITELLM_DOCKER_TAG=main-stable

# -----------------------------------------------------------------------------
# UMRS Database Configuration
# -----------------------------------------------------------------------------
DB_HOST=postgres
DB_SUPERUSER_PASSWORD=
DB_USER_PASSWORD=umrs_dev
UMRS_SERVER_HOST=umrs-server

# Postgres service credentials
POSTGRES_USER=umrs
POSTGRES_PASSWORD=umrs_dev
POSTGRES_DB=umrs

# Model cache locations (shared volume paths inside containers)
SENTENCE_TRANSFORMERS_HOME=/shared/models/sentence_transformers
HF_HOME=/shared/models/hf

# -----------------------------------------------------------------------------
# MinIO (S3-compatible storage) Configuration
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# UMRS client defaults
UMRS_ENDPOINT=http://ai-login:8000
POSTGRES_HOST=postgres
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# -----------------------------------------------------------------------------
# Offline Mode (no model downloads at runtime)
# -----------------------------------------------------------------------------
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1

# Force Slurm backend
UMRS_BACKEND=slurm
JOB_INFO_DIR=/var/run/rivault

# -----------------------------------------------------------------------------
# Vision / SAM3 Configuration
# -----------------------------------------------------------------------------
VISION_MODEL_PATH=./rivault/models/sam3
