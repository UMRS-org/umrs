{
  "name": "vision-pipeline-demo",
  "version": "1.0",
  "description": "Multi-step vision pipeline: SAM3 segmentation → region extraction → image statistics",
  "source": {
    "type": "local_path",
    "path": "./steps"
  },
  "requirements": ["Pillow", "numpy"],
  "steps": [
    {
      "name": "segment",
      "entrypoint": "segment:SegmentStep",
      "config": {
        "bentoml_url": "http://localhost:11434",
        "prompt": "object",
        "threshold": 0.5,
        "timeout": 600
      }
    },
    {
      "name": "crop_regions",
      "entrypoint": "crop_regions:CropRegionsStep",
      "config": {
        "min_patch_size": 32,
        "padding": 10,
        "max_patches_per_image": 20
      }
    },
    {
      "name": "image_stats",
      "entrypoint": "image_stats:ImageStatsStep",
      "config": {
        "output_prefix": "analysis/"
      }
    }
  ],
  "resources": {
    "gpu_count": 1,
    "memory_limit": "8Gi",
    "timeout_seconds": 3600,
    "extra": {
      "execution_mode": "in_process"
    }
  },
  "output": {
    "return_type": "file",
    "embedding_vector_size": 0
  }
}
