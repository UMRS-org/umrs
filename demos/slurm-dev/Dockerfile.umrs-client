# =============================================================================
# UMRS Client Container
# =============================================================================
# Lightweight container for interacting with UMRS.
# UMRS source and configs are bind-mounted at runtime; Python requirements
# are pre-installed at image build time for fast startup.
# =============================================================================
FROM python:3.11-slim

WORKDIR /app

# Install OS-level deps needed by UMRS client at runtime
RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential ca-certificates curl jq && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install UMRS Python requirements at build time (avoids re-installing every startup).
# The file is kept so the entrypoint can detect when the bind-mounted source has
# newer requirements and only re-install in that case.
COPY src/requirements.txt /opt/umrs-requirements.txt
RUN pip install --no-cache-dir -r /opt/umrs-requirements.txt
RUN python -m spacy download en_core_web_sm || true

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/opt/umrs

# Set UMRS_CONFIG to point to the directory containing conf_umrs.json (used by test script and client)
ENV UMRS_CONFIG /root/

COPY demos/slurm-dev/entrypoint-umrs-client.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
# nothing to run by default - this container is meant to be used as a test utility (e.g., via docker exec or in CI)
CMD ["/bin/bash"]
