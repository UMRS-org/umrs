# =============================================================================
# Environment Configuration for Slurm Development Demo
# =============================================================================
# Copy this to .env and customize for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# Model Configuration
# -----------------------------------------------------------------------------
# Path to model directory on the host (mounted into compute container)
MODEL_PATH=/path/to/your/models

# Model to use for demo
DEMO_MODEL_PATH=/models/qwen-0.5b

# -----------------------------------------------------------------------------
# Slurm Configuration
# -----------------------------------------------------------------------------
SLURM_PARTITION=dev
SLURM_TIME=01:00:00
SLURM_GPUS=0
SLURM_CPUS=4
SLURM_MEM=8G

# -----------------------------------------------------------------------------
# LiteLLM Configuration
# -----------------------------------------------------------------------------
LITELLM_PORT=11434
LITELLM_MASTER_KEY=sk-demo-dev

# -----------------------------------------------------------------------------
# UMRS Configuration
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=15432
DB_USER=umrs
DB_PASSWORD=umrs_dev
DB_NAME=umrs_demo

S3_ENDPOINT=http://localhost:19000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Force Slurm backend
UMRS_BACKEND=slurm
JOB_INFO_DIR=/var/run/rivault

# Offline mode (no model downloads)
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
