# Environment variables for demos/slurm-dev/docker-compose.yaml
# Copy this file to .env or edit values as needed for your environment.

# Rivault / LiteLLM / NGINX ports and keys
RIVAULT_REMOTE_PORT=11434
NGINX_LITELLM_DOCKER_PORT=11434
LITELLM_MASTER_KEY=sk-demo-dev

# UMRS database configuration
# DB_HOST can be a hostname reachable from containers (default: postgres service)
DB_HOST=postgres
DB_SUPERUSER_PASSWORD=
DB_USER_PASSWORD=umrs_dev
UMRS_SERVER_HOST=umrs-server

# Model cache locations (shared volume paths inside containers)
SENTENCE_TRANSFORMERS_HOME=/shared/models/sentence_transformers
HF_HOME=/shared/models/hf

# Compute node / models
MODEL_PATH=/tmp/models
VLLM_PATH_TO_HUGGINGFACE=/models

# Offline flags
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1

# Postgres service credentials (used by postgres service)
POSTGRES_USER=umrs
POSTGRES_PASSWORD=umrs_dev
POSTGRES_DB=umrs_demo

# MinIO credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# UMRS client defaults
UMRS_ENDPOINT=http://ai-login:8000
POSTGRES_HOST=postgres
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Add any other variables referenced in docker-compose.yaml here.# =============================================================================
# Environment Configuration for Slurm Development Demo
# =============================================================================
# Copy this to .env and customize for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# Host Compute Node
# -----------------------------------------------------------------------------
# FQDN of the host machine (for ai-login extra_hosts resolution).
# Used by SSH tunnels from slurmctld to reach Rivault on the host.
# Set to your machine's `hostname -f` output.
COMPUTE_HOST_FQDN=

# -----------------------------------------------------------------------------
# Model Configuration
# -----------------------------------------------------------------------------
# Path to model directory on the host
MODEL_PATH=./rivault/models

# Model to use for demo
DEMO_MODEL_PATH=/models/qwen-0.5b

# -----------------------------------------------------------------------------
# Slurm Configuration
# -----------------------------------------------------------------------------
SLURM_PARTITION=dev
SLURM_TIME=01:00:00
SLURM_GPUS=1
SLURM_CPUS=4
SLURM_MEM=8G

# -----------------------------------------------------------------------------
# Rivault / LiteLLM Configuration
# -----------------------------------------------------------------------------
# Port exposed by Rivault's NGINX→LiteLLM on the compute node
NGINX_LITELLM_DOCKER_PORT=11434
LITELLM_MASTER_KEY=sk-demo-dev

# Port used by rivault.py SSH tunnel (must match NGINX_LITELLM_DOCKER_PORT)
RIVAULT_REMOTE_PORT=11434

# -----------------------------------------------------------------------------
# UMRS Configuration
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=15432
DB_USER=umrs
DB_PASSWORD=umrs_dev
DB_NAME=umrs_demo

S3_ENDPOINT=http://localhost:19000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Force Slurm backend
UMRS_BACKEND=slurm
JOB_INFO_DIR=/var/run/rivault

# Offline mode (no model downloads)
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
