# =============================================================================
# AI-LOGIN Controller Dockerfile
# =============================================================================
# Runs the Slurm control daemon for job scheduling and hosts UMRS.
# =============================================================================

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install Slurm, SSH, and dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    slurm-wlm \
    slurmctld \
    munge \
    libmunge-dev \
    curl \
    jq \
    python3 \
    python3-pip \
    podman \
    openssh-server \
    openssh-client \
    ca-certificates \
    && pip3 install --no-cache-dir podman-compose || true \
    && rm -rf /var/lib/apt/lists/*

# Install MinIO client (mc) for bucket/user management; pick correct arch
RUN set -eux; \
        ARCH=$(uname -m); \
        case "$ARCH" in \
            x86_64|amd64) MC_ARCH=linux-amd64 ;; \
            aarch64|arm64) MC_ARCH=linux-arm64 ;; \
            *) MC_ARCH=linux-amd64 ;; \
        esac; \
        echo "Downloading mc for architecture=$ARCH (release/$MC_ARCH)"; \
        curl -fsSL https://dl.min.io/client/mc/release/${MC_ARCH}/mc -o /usr/local/bin/mc; \
        chmod +x /usr/local/bin/mc || true

# Copy UMRS source and install Python requirements before configuring SSH
# (placed early so layer caching benefits from unchanged system package layer)
COPY ./src/requirements.txt /tmp/requirements.txt
COPY ./src /opt/umrs

# Install Python requirements for UMRS (ignore failures to avoid blocking optional deps)
RUN pip3 install --no-cache-dir -r /tmp/requirements.txt || true

# Configure SSH for localhost tunneling (used by rivault.py forward_to_remote)
RUN mkdir -p /run/sshd /root/.ssh \
    && ssh-keygen -t ed25519 -f /root/.ssh/id_ed25519 -N "" \
    && cat /root/.ssh/id_ed25519.pub >> /root/.ssh/authorized_keys \
    && chmod 600 /root/.ssh/authorized_keys \
    && echo "StrictHostKeyChecking no" >> /root/.ssh/config \
    && echo "UserKnownHostsFile /dev/null" >> /root/.ssh/config \
    && chmod 600 /root/.ssh/config \
    && sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config

# Create necessary directories
RUN mkdir -p \
    /var/spool/slurmctld \
    /var/log/slurm \
    /var/run/rivault \
    /etc/slurm \
    && chown -R slurm:slurm /var/spool/slurmctld /var/log/slurm

# Copy entrypoint
COPY demos/slurm-dev/entrypoint-ai-login.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Copy configuration files (Slurm and UMRS)
COPY demos/slurm-dev/s3cfg /root/.s3cfg
COPY demos/slurm-dev/s3cfg_rivault_user /root/.s3cfg_rivault_user
COPY demos/slurm-dev/conf_umrs.json /root/conf_umrs.json
COPY demos/slurm-dev/user_files /root/user_files

# Set UMRS_CONFIG to point to the directory containing conf_umrs.json (used by server and client)
ENV UMRS_CONFIG /root/

# Ensure UMRS code is on PYTHONPATH
ENV PYTHONPATH=/opt/umrs:${PYTHONPATH:-}

EXPOSE 6817

ENTRYPOINT ["/entrypoint.sh"]
CMD ["slurmctld", "-D", "-vv"]
