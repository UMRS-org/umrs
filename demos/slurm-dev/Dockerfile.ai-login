# =============================================================================
# AI-LOGIN Controller Dockerfile
# =============================================================================
# Runs the Slurm control daemon for job scheduling and hosts UMRS.
# =============================================================================

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install Slurm, SSH, and dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    slurm-wlm \
    slurmctld \
    munge \
    libmunge-dev \
    curl \
    jq \
    python3 \
    python3-pip \
    podman \
    openssh-server \
    openssh-client \
    && pip3 install --no-cache-dir podman-compose || true \
    && rm -rf /var/lib/apt/lists/*

# Copy UMRS source and install Python requirements before configuring SSH
# (placed early so layer caching benefits from unchanged system package layer)
COPY ./src/requirements.txt /tmp/requirements.txt
COPY ./src /opt/umrs

# Install Python requirements for UMRS (ignore failures to avoid blocking optional deps)
RUN pip3 install --no-cache-dir -r /tmp/requirements.txt || true

# Configure SSH for localhost tunneling (used by rivault.py forward_to_remote)
RUN mkdir -p /run/sshd /root/.ssh \
    && ssh-keygen -t ed25519 -f /root/.ssh/id_ed25519 -N "" \
    && cat /root/.ssh/id_ed25519.pub >> /root/.ssh/authorized_keys \
    && chmod 600 /root/.ssh/authorized_keys \
    && echo "StrictHostKeyChecking no" >> /root/.ssh/config \
    && echo "UserKnownHostsFile /dev/null" >> /root/.ssh/config \
    && chmod 600 /root/.ssh/config \
    && sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config

# Create necessary directories
RUN mkdir -p \
    /var/spool/slurmctld \
    /var/log/slurm \
    /var/run/rivault \
    /etc/slurm \
    && chown -R slurm:slurm /var/spool/slurmctld /var/log/slurm

# Copy entrypoint
COPY demos/slurm-dev/entrypoint-ai-login.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Ensure UMRS code is on PYTHONPATH
ENV PYTHONPATH=/opt/umrs:${PYTHONPATH:-}

EXPOSE 6817

ENTRYPOINT ["/entrypoint.sh"]
CMD ["slurmctld", "-D", "-vv"]
