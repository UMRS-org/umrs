# =============================================================================
# AI-LOGIN Controller Dockerfile
# =============================================================================
# Runs the Slurm control daemon for job scheduling and hosts UMRS.
# NOTE: Must use Ubuntu 24.04 so the packaged Slurm (23.11.4) matches
#       the host's slurmd version — protocol versions must be identical.
# =============================================================================

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
# Allow pip to install packages system-wide (PEP 668 / Python 3.12)
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# Install Slurm, SSH, and dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    slurm-wlm \
    slurmctld \
    munge \
    libmunge-dev \
    curl \
    jq \
    python3 \
    python3-pip \
    podman \
    openssh-server \
    openssh-client \
    ca-certificates \
    && pip3 install --no-cache-dir podman-compose || true \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV UV_SYSTEM_PYTHON=1 \
    UV_BREAK_SYSTEM_PACKAGES=1 \
    UV_NO_CACHE=1

# Install UMRS Python requirements at build time (avoids re-installing every startup).
# The file is kept so the entrypoint can detect when the bind-mounted source has
# newer requirements and only re-install in that case.
COPY src/requirements.txt /opt/umrs-requirements.txt
RUN uv pip install -r /opt/umrs-requirements.txt
RUN python3 -m spacy download en_core_web_sm || true

# Install MinIO client (mc) for bucket/user management; pick correct arch
RUN set -eux; \
        ARCH=$(uname -m); \
        case "$ARCH" in \
            x86_64|amd64) MC_ARCH=linux-amd64 ;; \
            aarch64|arm64) MC_ARCH=linux-arm64 ;; \
            *) MC_ARCH=linux-amd64 ;; \
        esac; \
        echo "Downloading mc for architecture=$ARCH (release/$MC_ARCH)"; \
        curl -fsSL https://dl.min.io/client/mc/release/${MC_ARCH}/mc -o /usr/local/bin/mc; \
        chmod +x /usr/local/bin/mc || true

# NOTE: UMRS source is bind-mounted at runtime (../../src:/opt/umrs:ro).
# This avoids rebuilding the image on every source change.

# Configure SSH for localhost tunneling (used by rivault.py forward_to_remote)
RUN mkdir -p /run/sshd /root/.ssh \
    && ssh-keygen -t ed25519 -f /root/.ssh/id_ed25519 -N "" \
    && cat /root/.ssh/id_ed25519.pub >> /root/.ssh/authorized_keys \
    && chmod 600 /root/.ssh/authorized_keys \
    && echo "StrictHostKeyChecking no" >> /root/.ssh/config \
    && echo "UserKnownHostsFile /dev/null" >> /root/.ssh/config \
    && chmod 600 /root/.ssh/config \
    && sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config

# Create necessary directories
RUN mkdir -p \
    /var/spool/slurmctld \
    /var/log/slurm \
    /var/run/rivault \
    /etc/slurm \
    && chown -R slurm:slurm /var/spool/slurmctld /var/log/slurm

# Copy entrypoint
COPY demos/slurm-dev/entrypoint-ai-login.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# NOTE: Configuration files (s3cfg, conf_umrs.json, user_files) are
# bind-mounted at runtime via docker-compose volumes.

# Set UMRS_CONFIG to point to the directory containing conf_umrs.json (used by server and client)
ENV UMRS_CONFIG /root/

# Ensure UMRS code is on PYTHONPATH
ENV PYTHONPATH=/opt/umrs:${PYTHONPATH:-}

# Disable Python output buffering so logs appear in real time
ENV PYTHONUNBUFFERED=1

EXPOSE 6817

ENTRYPOINT ["/entrypoint.sh"]
CMD ["slurmctld", "-D", "-vv"]
