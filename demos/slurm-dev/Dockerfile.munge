# =============================================================================
# Munge Authentication Daemon
# =============================================================================
# Munge provides authentication between Slurm components.
# This container generates and shares the munge key.
#
# The key is stored in /etc/munge and shared via Docker volume.
# =============================================================================

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# NOTE: munge's postinst script runs `su munge …` which fails in rootless
# Podman when force_mask is set (strips setuid from /bin/su).  We install the
# library first, then force-install the munge package ignoring the postinst error.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libmunge2 libmunge-dev \
    && apt-get install -y --no-install-recommends munge || true \
    && dpkg --configure -a --force-all || true \
    && rm -rf /var/lib/apt/lists/*

# Create munge directories
RUN mkdir -p /etc/munge /var/log/munge /run/munge \
    && chown -R munge:munge /etc/munge /var/log/munge /run/munge

# Generate munge key if not exists
COPY entrypoint-munge.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Run entrypoint as root so it can fix permissions on the
# bind-mounted munge-key directory, then exec munged as munge user.
WORKDIR /run/munge

ENTRYPOINT ["/entrypoint.sh"]
CMD ["munged", "-F"]
