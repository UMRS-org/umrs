# =============================================================================
# Slurm Controller (slurmctld)
# =============================================================================
# Runs the Slurm control daemon for job scheduling.
# Requires munge key from shared volume.
# =============================================================================

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install Slurm and dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    slurm-wlm \
    slurmctld \
    munge \
    libmunge-dev \
    curl \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Create necessary directories
RUN mkdir -p \
    /var/spool/slurmctld \
    /var/log/slurm \
    /var/run/rivault \
    /etc/slurm \
    && chown -R slurm:slurm /var/spool/slurmctld /var/log/slurm

# Copy entrypoint
COPY entrypoint-slurmctld.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 6817

ENTRYPOINT ["/entrypoint.sh"]
CMD ["slurmctld", "-D", "-vv"]
