# Environment file (contains secrets)
.env

# Local test data
*.log
*.pid

# Munge key (generated at runtime)
munge-key/

# Shared directories (host ↔ container runtime state)
job-info/
umrs-config/*
# But keep vision model configs
!umrs-config/vision_models.json

# NVIDIA driver libs (copied from host CDI spec)
nvidia-driver-libs/

# Rivault runtime-generated files (per-session UUIDs)
rivault/env.*
rivault/coredns_fs/coredns.conf.*
rivault/nginx_fs/out-nginx.conf.*

# Pre-saved container images (large binary tarballs)
rivault-images/
