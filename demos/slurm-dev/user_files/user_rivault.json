{
  "username": "rivault_user",
  "fullname": "Rivault Demo User",
  "s3_configuration_file": "~/.s3cfg_user1",
  "experiences": [
    {
      "xp_name": "Rivault Embedding XP",
      "sql_username": "rivault_usr",
      "modalities": [
        {
          "modality_name": "text",
          "s3": {
            "bucket_alias": "rivault-demo-bucket",
            "data": { "type": "file", "mime_type": "text/plain" }
          },
          "model": {
            "model_name": "rivault-demo-model",
            "vector_size": "1536",
            "model_type": "rivault://openai://http://localhost:{LOCAL_PORT}/v1",
            "description": "Launches a Rivault-served OpenAI-compatible embedding endpoint via Slurm"
          },
          "sql": {
            "store_embeddings": "yes",
            "table_name": "rivault_text",
            "meta_data": [ { "name": "source", "type": "TEXT" } ]
          }
        }
      ]
    }
  ]
}
