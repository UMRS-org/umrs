{
  "username": "rivault_user",
  "fullname": "Rivault Demo User",
  "s3_configuration_file": "~/.s3cfg_rivault_user",
  "experiences": [
    {
      "xp_name": "Text_Rivault",
      "sql_username": "rivault_user",
      "modalities": [
        {
          "modality_name": "text",
          "s3": {
            "bucket_alias": "bucket-vLLM",
             "data": {
              "type": "inline",
              "mime_type": "text/plain"
            },
            "need_output_bucket": false
          },
          "model": {
            "model_name": "intfloat/e5-base-v2",
            "vector_size": "768",
            "model_type": "rivault://openai://http://localhost:8001/v1",
            "spacy_model": "en_core_web_sm",
            "return_type": null
          },
          "sql": {
            "store_embeddings": "yes",
            "table_name": "text",
            "meta_data": [
              {
                "name": "keywords",
                "type": "TEXT"
              }
            ]
          }
        }
      ]

    }
  ]
}