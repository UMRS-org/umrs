# =============================================================================
# Compute Node Dockerfile (compute-01)
# =============================================================================
# Runs the Slurm compute daemon for job execution.
# =============================================================================

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install Slurm, Python, and dependencies for podman-in-podman
RUN apt-get update && apt-get install -y --no-install-recommends \
    slurm-wlm \
    slurmd \
    munge \
    libmunge-dev \
    python3 \
    python3-pip \
    podman \
    fuse-overlayfs \
    curl \
    jq \
    openssl \
    openssh-server \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir podman-compose || true

# Create necessary directories
RUN mkdir -p \
    /var/spool/slurmd \
    /var/log/slurm \
    /var/run/rivault \
    /etc/slurm \
    /models \
    /opt/rivault \
    && chown -R slurm:slurm /var/spool/slurmd /var/log/slurm

# Configure SSH (for debugging)
RUN mkdir -p /run/sshd \
    && echo 'root:slurm' | chpasswd \
    && sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config

# Copy entrypoint
COPY entrypoint-compute.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 22 6818 11434 8000

ENTRYPOINT ["/entrypoint.sh"]
CMD ["slurmd", "-D", "-vv"]
