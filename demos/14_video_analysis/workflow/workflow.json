{
  "name": "video-motion-analysis",
  "version": "1.0",
  "description": "Detect motion events in video files using frame differencing (no external model required)",
  "source": {
    "type": "uploaded",
    "path": "."
  },
  "requirements": ["opencv-python-headless", "numpy"],
  "steps": [
    {
      "name": "motion_detect",
      "entrypoint": "motion_step:MotionDetectStep",
      "config": {
        "diff_threshold": 30,
        "area_threshold": 500,
        "min_event_frames": 3,
        "sample_fps": 5,
        "output_prefix": "results/"
      }
    }
  ],
  "resources": {
    "gpu_count": 0,
    "cpu_count": 4,
    "memory_limit": "8Gi",
    "timeout_seconds": 1800
  },
  "output": {
    "return_type": "file",
    "embedding_vector_size": 0
  }
}
