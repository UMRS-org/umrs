{
    "name": "hmae-inference-pipeline",
    "version": "1.0",
    "description": "HMAE (Hierarchical Masked Autoencoder) inference via user_script (no BentoML required)",
    "source": {
        "type": "local_path",
        "path": "/PLACEHOLDER/scripts"
    },
    "requirements": [
        "torch",
        "opencv-python",
        "numpy",
        "matplotlib",
        "PyYAML"
    ],
    "resources": {
        "gpu_count": 1,
        "cpu_limit": "4",
        "memory_limit": "8Gi",
        "timeout_seconds": 600
    },
    "steps": [
        {
            "name": "hmae_inference",
            "entrypoint": "hmae_inference:HMAEInferenceStep",
            "config": {
                "output_prefix": "hmae_out/",
                "task": "reconstruction",
                "cfg_file": "/PLACEHOLDER/infer_hmae_vit_b.yaml",
                "checkpoint_path": "/PLACEHOLDER/latest_checkpoint.pth"
            }
        }
    ],
    "output": {
        "return_type": "file",
        "embedding_vector_size": 0
    }
}
