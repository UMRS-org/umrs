{
    "name": "sam3-segmentation-pipeline",
    "version": "1.0",
    "description": "SAM3 automatic mask segmentation via user_script (no BentoML required)",
    "source": {
        "type": "local_path",
        "path": "/PLACEHOLDER/scripts"
    },
    "requirements": [
        "torch",
        "sam2",
        "Pillow",
        "numpy"
    ],
    "resources": {
        "gpu_count": 1,
        "cpu_limit": "4",
        "memory_limit": "8Gi",
        "timeout_seconds": 600
    },
    "steps": [
        {
            "name": "sam3_segment",
            "entrypoint": "sam3_segment:SAM3SegmentStep",
            "config": {
                "output_prefix": "segmented/",
                "model_id": "facebook/sam2-hiera-small",
                "points_per_side": 32
            }
        }
    ],
    "output": {
        "return_type": "file",
        "embedding_vector_size": 0
    }
}
