<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" office:mimetype="application/vnd.oasis.opendocument.presentation" office:version="1.3">
<office:automatic-styles>
<style:style style:name="Page" style:family="drawing-page"><style:drawing-page-properties draw:fill="solid" draw:fill-color="#f6f3ed"/></style:style>
<style:style style:name="Title" style:family="paragraph"><style:text-properties fo:font-size="32pt" fo:font-weight="bold" fo:color="#17324d"/></style:style>
<style:style style:name="Body" style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0.23in"/><style:text-properties fo:font-size="20pt" fo:color="#263c4d"/></style:style>
<style:style style:name="Footer" style:family="paragraph"><style:text-properties fo:font-size="10pt" fo:color="#5a6570"/></style:style>
<style:style style:name="TitleFrame" style:family="graphic"/><style:style style:name="BodyFrame" style:family="graphic"/><style:style style:name="FooterFrame" style:family="graphic"/><style:style style:name="ArchitectureFrame" style:family="graphic"/>
</office:automatic-styles><office:body><office:presentation><draw:page draw:name="Slide 1" draw:style-name="Page" draw:master-page-name="Default">
<draw:frame draw:style-name="TitleFrame" svg:x="1.1in" svg:y="0.7in" svg:width="11.1in" svg:height="0.7in"><draw:text-box><text:p text:style-name="Title">UMRS Demo Day</text:p></draw:text-box></draw:frame>
<draw:frame draw:style-name="BodyFrame" svg:x="1.3in" svg:y="1.85in" svg:width="10.8in" svg:height="4.8in"><draw:text-box><text:p text:style-name="Body">Unified Multimodal Retrieval System</text:p><text:p text:style-name="Body">Text RAG, SAM3.1 segmentation, and HMAE reconstruction</text:p><text:p text:style-name="Body">Validated against rccs-cloud profile on 2026-07-20</text:p></draw:text-box></draw:frame>
<draw:frame draw:style-name="FooterFrame" svg:x="1.1in" svg:y="6.85in" svg:width="11in" svg:height="0.35in"><draw:text-box><text:p text:style-name="Footer">UMRS Demo Day | rccs-cloud validation</text:p></draw:text-box></draw:frame>
</draw:page><draw:page draw:name="Slide 2" draw:style-name="Page" draw:master-page-name="Default">
<draw:frame draw:style-name="TitleFrame" svg:x="1.1in" svg:y="0.7in" svg:width="11.1in" svg:height="0.7in"><draw:text-box><text:p text:style-name="Title">What UMRS Does</text:p></draw:text-box></draw:frame>
<draw:frame draw:style-name="BodyFrame" svg:x="1.3in" svg:y="1.85in" svg:width="10.8in" svg:height="4.8in"><draw:text-box><text:p text:style-name="Body">Receives multimodal data through isolated bucket aliases.</text:p><text:p text:style-name="Body">Coordinates durable jobs, workflows, model access, and result storage.</text:p><text:p text:style-name="Body">Runs HPC workloads through Slurm and controlled container runtimes.</text:p><text:p text:style-name="Body">Keeps client, storage, database, and GPU ownership separate.</text:p></draw:text-box></draw:frame>
<draw:frame draw:style-name="FooterFrame" svg:x="1.1in" svg:y="6.85in" svg:width="11in" svg:height="0.35in"><draw:text-box><text:p text:style-name="Footer">UMRS Demo Day | rccs-cloud validation</text:p></draw:text-box></draw:frame>
</draw:page><draw:page draw:name="Slide 3" draw:style-name="Page" draw:master-page-name="Default">
<draw:frame draw:style-name="TitleFrame" svg:x="1.1in" svg:y="0.7in" svg:width="11.1in" svg:height="0.7in"><draw:text-box><text:p text:style-name="Title">Architecture</text:p></draw:text-box></draw:frame>
<draw:frame draw:style-name="BodyFrame" svg:x="1.3in" svg:y="1.85in" svg:width="5.1in" svg:height="4.8in"><draw:text-box><text:p text:style-name="Body">umrs-client and r4 are user-facing clients.</text:p><text:p text:style-name="Body">UMRS owns durable workflow and job semantics.</text:p><text:p text:style-name="Body">MinIO/S3 carries inputs and generated outputs.</text:p><text:p text:style-name="Body">PostgreSQL/pgvector stores RAG state; Slurm hosts GPU execution.</text:p></draw:text-box></draw:frame><draw:frame draw:style-name="ArchitectureFrame" svg:x="7.0in" svg:y="2.0in" svg:width="5.1in" svg:height="3.0in"><draw:image xlink:href="architecture.svg" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad"/></draw:frame>
<draw:frame draw:style-name="FooterFrame" svg:x="1.1in" svg:y="6.85in" svg:width="11in" svg:height="0.35in"><draw:text-box><text:p text:style-name="Footer">UMRS Demo Day | rccs-cloud validation</text:p></draw:text-box></draw:frame>
</draw:page><draw:page draw:name="Slide 4" draw:style-name="Page" draw:master-page-name="Default">
<draw:frame draw:style-name="TitleFrame" svg:x="1.1in" svg:y="0.7in" svg:width="11.1in" svg:height="0.7in"><draw:text-box><text:p text:style-name="Title">Live Environment Evidence</text:p></draw:text-box></draw:frame>
<draw:frame draw:style-name="BodyFrame" svg:x="1.3in" svg:y="1.85in" svg:width="10.8in" svg:height="4.8in"><draw:text-box><text:p text:style-name="Body">rccs-cloud server reachable: data0.ai.r-ccs.riken.jp:50090.</text:p><text:p text:style-name="Body">35 system model registrations, including hmae and sam3.1.</text:p><text:p text:style-name="Body">Experience add followed by reload created six synchronized aliases.</text:p><text:p text:style-name="Body">Text bucket and all private aliases are isolated by modality and task.</text:p></draw:text-box></draw:frame>
<draw:frame draw:style-name="FooterFrame" svg:x="1.1in" svg:y="6.85in" svg:width="11in" svg:height="0.35in"><draw:text-box><text:p text:style-name="Footer">UMRS Demo Day | rccs-cloud validation</text:p></draw:text-box></draw:frame>
</draw:page><draw:page draw:name="Slide 5" draw:style-name="Page" draw:master-page-name="Default">
<draw:frame draw:style-name="TitleFrame" svg:x="1.1in" svg:y="0.7in" svg:width="11.1in" svg:height="0.7in"><draw:text-box><text:p text:style-name="Title">Demo 1: Text RAG</text:p></draw:text-box></draw:frame>
<draw:frame draw:style-name="BodyFrame" svg:x="1.3in" svg:y="1.85in" svg:width="10.8in" svg:height="4.8in"><draw:text-box><text:p text:style-name="Body">Use mnagaso3-text for document ingestion and embeddings.</text:p><text:p text:style-name="Body">Upload a directory of text files, then inspect data list and status.</text:p><text:p text:style-name="Body">RAG pipeline creation requires a valid JSON pipeline file for r4.</text:p><text:p text:style-name="Body">Narrative: object storage input -&gt; embedding/indexing -&gt; retrieval-ready corpus.</text:p></draw:text-box></draw:frame>
<draw:frame draw:style-name="FooterFrame" svg:x="1.1in" svg:y="6.85in" svg:width="11in" svg:height="0.35in"><draw:text-box><text:p text:style-name="Footer">UMRS Demo Day | rccs-cloud validation</text:p></draw:text-box></draw:frame>
</draw:page><draw:page draw:name="Slide 6" draw:style-name="Page" draw:master-page-name="Default">
<draw:frame draw:style-name="TitleFrame" svg:x="1.1in" svg:y="0.7in" svg:width="11.1in" svg:height="0.7in"><draw:text-box><text:p text:style-name="Title">Demo 2: SAM3.1 Segmentation</text:p></draw:text-box></draw:frame>
<draw:frame draw:style-name="BodyFrame" svg:x="1.3in" svg:y="1.85in" svg:width="10.8in" svg:height="4.8in"><draw:text-box><text:p text:style-name="Body">Use demo-defect, provisioned as image / segmentation.</text:p><text:p text:style-name="Body">Live upload of Cat_1.jpg completed with status=ok.</text:p><text:p text:style-name="Body">Model registration is facebook/sam2-hiera-small through the SAM3 adapter.</text:p><text:p text:style-name="Body">Download target is the paired output bucket, not the input bucket.</text:p></draw:text-box></draw:frame>
<draw:frame draw:style-name="FooterFrame" svg:x="1.1in" svg:y="6.85in" svg:width="11in" svg:height="0.35in"><draw:text-box><text:p text:style-name="Footer">UMRS Demo Day | rccs-cloud validation</text:p></draw:text-box></draw:frame>
</draw:page><draw:page draw:name="Slide 7" draw:style-name="Page" draw:master-page-name="Default">
<draw:frame draw:style-name="TitleFrame" svg:x="1.1in" svg:y="0.7in" svg:width="11.1in" svg:height="0.7in"><draw:text-box><text:p text:style-name="Title">Demo 3: HMAE Reconstruction</text:p></draw:text-box></draw:frame>
<draw:frame draw:style-name="BodyFrame" svg:x="1.3in" svg:y="1.85in" svg:width="10.8in" svg:height="4.8in"><draw:text-box><text:p text:style-name="Body">Use demo-hmae for reconstruction; companion aliases support MAE and features.</text:p><text:p text:style-name="Body">Live upload of Cat_1.jpg completed with status=ok.</text:p><text:p text:style-name="Body">HMAE ViT-B is registered as a vision model in the experience.</text:p><text:p text:style-name="Body">Show output only after server-side execution creates artifacts in the output bucket.</text:p></draw:text-box></draw:frame>
<draw:frame draw:style-name="FooterFrame" svg:x="1.1in" svg:y="6.85in" svg:width="11in" svg:height="0.35in"><draw:text-box><text:p text:style-name="Footer">UMRS Demo Day | rccs-cloud validation</text:p></draw:text-box></draw:frame>
</draw:page><draw:page draw:name="Slide 8" draw:style-name="Page" draw:master-page-name="Default">
<draw:frame draw:style-name="TitleFrame" svg:x="1.1in" svg:y="0.7in" svg:width="11.1in" svg:height="0.7in"><draw:text-box><text:p text:style-name="Title">Private Experience Provisioning</text:p></draw:text-box></draw:frame>
<draw:frame draw:style-name="BodyFrame" svg:x="1.3in" svg:y="1.85in" svg:width="10.8in" svg:height="4.8in"><draw:text-box><text:p text:style-name="Body">Normal flow: experience add &lt;experience.json&gt; --update, then reload.</text:p><text:p text:style-name="Body">Verified aliases: demo-defect, demo-hmae, demo-hmae-mae, demo-hmae-features, demo-opossum.</text:p><text:p text:style-name="Body">Provisioning succeeded; no text-bucket fallback is used for vision workloads.</text:p><text:p text:style-name="Body">HMAE experience definitions merge by xp_name; full pipeline aliases are present after reload.</text:p></draw:text-box></draw:frame>
<draw:frame draw:style-name="FooterFrame" svg:x="1.1in" svg:y="6.85in" svg:width="11in" svg:height="0.35in"><draw:text-box><text:p text:style-name="Footer">UMRS Demo Day | rccs-cloud validation</text:p></draw:text-box></draw:frame>
</draw:page><draw:page draw:name="Slide 9" draw:style-name="Page" draw:master-page-name="Default">
<draw:frame draw:style-name="TitleFrame" svg:x="1.1in" svg:y="0.7in" svg:width="11.1in" svg:height="0.7in"><draw:text-box><text:p text:style-name="Title">Runbook Reality Check</text:p></draw:text-box></draw:frame>
<draw:frame draw:style-name="BodyFrame" svg:x="1.3in" svg:y="1.85in" svg:width="10.8in" svg:height="4.8in"><draw:text-box><text:p text:style-name="Body">Result directories must exist before data download.</text:p><text:p text:style-name="Body">Current upload checks prove S3 ingestion, not completed GPU inference.</text:p><text:p text:style-name="Body">After test uploads, status all showed server idle and no generated outputs were observed.</text:p><text:p text:style-name="Body">Opossum is provisioned but lacks a repository MP4 fixture for end-to-end execution.</text:p></draw:text-box></draw:frame>
<draw:frame draw:style-name="FooterFrame" svg:x="1.1in" svg:y="6.85in" svg:width="11in" svg:height="0.35in"><draw:text-box><text:p text:style-name="Footer">UMRS Demo Day | rccs-cloud validation</text:p></draw:text-box></draw:frame>
</draw:page><draw:page draw:name="Slide 10" draw:style-name="Page" draw:master-page-name="Default">
<draw:frame draw:style-name="TitleFrame" svg:x="1.1in" svg:y="0.7in" svg:width="11.1in" svg:height="0.7in"><draw:text-box><text:p text:style-name="Title">Demo Sequence</text:p></draw:text-box></draw:frame>
<draw:frame draw:style-name="BodyFrame" svg:x="1.3in" svg:y="1.85in" svg:width="10.8in" svg:height="4.8in"><draw:text-box><text:p text:style-name="Body">1. umrs-client --profile rccs-cloud ping</text:p><text:p text:style-name="Body">2. umrs-client --profile rccs-cloud bucket list</text:p><text:p text:style-name="Body">3. Text upload to mnagaso3-text and RAG inspection.</text:p><text:p text:style-name="Body">4. SAM3 upload to demo-defect, then monitor and download output when job appears.</text:p><text:p text:style-name="Body">5. HMAE upload to demo-hmae, then monitor and download output when job appears.</text:p><text:p text:style-name="Body">6. Show doctor report and explain operational follow-up for idle processing.</text:p></draw:text-box></draw:frame>
<draw:frame draw:style-name="FooterFrame" svg:x="1.1in" svg:y="6.85in" svg:width="11in" svg:height="0.35in"><draw:text-box><text:p text:style-name="Footer">UMRS Demo Day | rccs-cloud validation</text:p></draw:text-box></draw:frame>
</draw:page></office:presentation></office:body></office:document>