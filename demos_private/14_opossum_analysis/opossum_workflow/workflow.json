{
    "name": "opossum-analysis",
    "version": "1.0",
    "description": "Video motion detection pipeline using frame-difference analysis",
    "source": {
        "type": "local_path",
        "path": "."
    },
    "requirements": ["opencv-python-headless", "numpy"],
    "resources": {
        "gpu_count": 0,
        "cpu_limit": "4",
        "memory_limit": "8Gi",
        "timeout_seconds": 1800
    },
    "steps": [
        {
            "name": "opossum_analyze",
            "entrypoint": "opossum_step:OpossumAnalyzeStep",
            "config": {
                "distance_threshold": 0.05,
                "time_threshold": 15
            }
        }
    ],
    "output": {
        "return_type": "file",
        "embedding_vector_size": 0
    }
}
