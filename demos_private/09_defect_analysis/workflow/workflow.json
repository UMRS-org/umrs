{
  "name": "structural-defect-analysis",
  "description": "Automated structural defect analysis: SAM3 segmentation → region extraction → HMAE features + anomaly detection → structure clustering",
  "source": {
    "type": "uploaded",
    "path": "steps"
  },
  "steps": [
    {
      "name": "sam3_segment",
      "entrypoint": "sam3_segmentation:SAM3SegmentationStep",
      "depends_on": [],
      "config": {
        "bentoml_url": "${BENTOML_URL:-http://localhost:11434/vision}",
        "prompt": "defect",
        "threshold": 0.5,
        "mask_threshold": 0.5,
        "timeout": 600
      }
    },
    {
      "name": "region_extract",
      "entrypoint": "region_extraction:RegionExtractionStep",
      "depends_on": ["sam3_segment"],
      "config": {
        "min_patch_size": 32,
        "padding": 10,
        "max_patches_per_image": 50
      }
    },
    {
      "name": "hmae_analysis",
      "entrypoint": "hmae_analysis:HMAEAnalysisStep",
      "depends_on": ["region_extract"],
      "config": {
        "bentoml_url": "${BENTOML_URL:-http://localhost:11434/vision}",
        "anomaly_threshold": 0.3,
        "timeout": 300
      }
    },
    {
      "name": "structure_discovery",
      "entrypoint": "structure_discovery:StructureDiscoveryStep",
      "depends_on": ["hmae_analysis"],
      "config": {
        "n_clusters": 4,
        "anomaly_prefix": "anomaly/"
      }
    }
  ],
  "resources": {
    "gpu_count": 1,
    "memory_limit": "16Gi",
    "timeout_seconds": 7200,
    "extra": {
      "execution_mode": "in_process"
    }
  },
  "output": {
    "return_type": "raw",
    "embedding_vector_size": 768
  },
  "env": {}
}
