{
  "name": "hmae-full-pipeline",
  "version": "1.0",
  "description": "Run all 3 HMAE inference modes: full reconstruction, masked reconstruction (anomaly scoring), and feature extraction",
  "source": {
    "type": "uploaded",
    "path": "steps"
  },
  "steps": [
    {
      "name": "hmae_reconstruct",
      "entrypoint": "hmae_reconstruct:HMAEReconstructStep",
      "depends_on": [],
      "model": "HMAE ViT-B",
      "requires": ["vision"],
      "model_type": "vision",
      "config": {
        "timeout": 600
      }
    },
    {
      "name": "hmae_mae",
      "entrypoint": "hmae_mae:HMAEMaeStep",
      "depends_on": ["hmae_reconstruct"],
      "model": "HMAE ViT-B",
      "requires": ["vision"],
      "model_type": "vision",
      "config": {
        "anomaly_threshold": 0.3,
        "timeout": 600
      }
    },
    {
      "name": "hmae_features",
      "entrypoint": "hmae_features:HMAEFeaturesStep",
      "depends_on": ["hmae_mae"],
      "model": "HMAE ViT-B",
      "requires": ["vision"],
      "model_type": "vision",
      "config": {
        "timeout": 600
      }
    }
  ],
  "resources": {
    "gpu_count": 1,
    "memory_limit": "16Gi",
    "timeout_seconds": 3600
  },
  "output": {
    "return_type": "file",
    "embedding_vector_size": 768
  },
  "env": {}
}
