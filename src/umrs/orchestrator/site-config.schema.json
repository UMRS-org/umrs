{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umrs.local/site-config.schema.json",
  "title": "UMRS Site Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "extends": {
      "type": "string",
      "description": "ADR-045 D5: path of a base site.yaml (relative to this file unless absolute) loaded first; this file deep-merges over it — mappings merge key by key, scalars and lists replace."
    },
    "strict_secrets": { "type": "boolean" },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "scheduler": {
      "$ref": "#/$defs/scheduler"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "storage": {
      "$ref": "#/$defs/storage"
    },
    "network": {
      "$ref": "#/$defs/network"
    },
    "vllm": {
      "$ref": "#/$defs/vllm"
    },
    "step_executor": {
      "$ref": "#/$defs/step_executor"
    },
    "database": {
      "$ref": "#/$defs/database"
    },
    "extra": {
      "type": "object"
    },
    "partition_profiles": {
      "type": "object",
      "description": "Declarative per-partition hardware and runtime profiles. Keys are partition names.",
      "additionalProperties": {
        "$ref": "#/$defs/partition_profile"
      }
    }
  },
  "required": [
    "name"
  ],
  "$defs": {
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodes": { "type": "integer", "minimum": 0 },
        "require_user_slurm_account": { "type": "boolean" },
        "slurm_delegation": { "type": "string" },
        "service_pubkey_path": { "type": "string" },
        "slurm_proxy_path": { "type": "string" },
        "kind": { "type": "string" },
        "partition": { "type": "string" },
        "account": { "type": "string" },
        "qos": { "type": "string" },
        "time_limit": { "type": "string" },
        "gpus": { "type": "integer", "minimum": 0 },
        "cpus": { "type": "integer", "minimum": 0 },
        "memory": { "type": "string" },
        "extra_sbatch": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network_config_dir": {
          "type": "string",
          "description": "ADR-045 D1: node-local directory for podman network configs (default <graphroot parent>/networks) — keeps them off the shared $HOME."
        },
        "image_archive_dir": {
          "type": "string",
          "description": "ADR-045 D3: shared-filesystem directory of `podman save` archives (<name>-<tag>-<arch>.tar) that compute nodes load when an image is absent from their node-local store and no registry serves it."
        },
        "kind": { "type": "string" },
        "compose_file": { "type": "string" },
        "rivault_dir": { "type": "string" },
        "repo_dir": { "type": "string" },
        "vision_image": { "type": "string" },
        "profiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "gpu_passthrough": { "type": "string" },
        "cdi_spec": { "type": "string" },
        "cgroup_manager": { "type": "string" },
        "storage_root": { "type": "string" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_cache_dir": { "type": "string" },
        "sam3_model_path": { "type": "string" },
        "hmae_model_path": { "type": "string" },
        "hmae_config_path": { "type": "string" },
        "hmae_checkpoint": { "type": "string" },
        "vision_tarball": { "type": "string" },
        "user_model_path": { "type": "string" },
        "s3_tunnel_host": { "type": "string" },
        "s3_tunnel_port": { "type": "integer", "minimum": 0 }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "egress_proxy_url": { "type": "string" },
        "egress_no_proxy": { "type": "string" },
        "egress_proxy_image": {
          "type": "string",
          "description": "ADR-040 D4: in-stack egress-guard image; empty = none declared, egress_domains provisions are refused."
        },
        "private_subnet_pool": {
          "type": "string",
          "description": "ADR-045 D2: a.b.0.0/16 pool the wrapper allocates each job's private /24 from (job-id-derived offset), or one fixed a.b.c.0/24. Empty = 172.16.0.0/16."
        },
        "litellm_port": { "type": "integer", "minimum": 0 },
        "litellm_master_key": { "type": "string" },
        "port_range_min": { "type": "integer", "minimum": 0 },
        "port_range_max": { "type": "integer", "minimum": 0 },
        "port_strategy": { "type": "string" }
      }
    },
    "vllm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enable_prefix_caching": { "type": "boolean" },
        "model": { "type": "string" },
        "docker_tag": { "type": "string" },
        "gpu_mem_util": { "type": "number", "minimum": 0 },
        "max_model_len": { "type": "integer", "minimum": 0 },
        "max_num_seqs": { "type": "integer", "minimum": 0 },
        "tensor_parallel_size": { "type": "integer", "minimum": 0 }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 0 },
        "superuser": { "type": "string" },
        "superuser_password": { "type": "string" },
        "user_password": { "type": "string" },
        "registry_dsn": { "type": "string" }
      }
    },
    "step_executor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["inproc", "slurm", "podman", "subprocess"] },
        "partition": { "type": "string" },
        "gpus": { "type": "integer", "minimum": 0 },
        "cpus": { "type": "integer", "minimum": 0 },
        "memory": { "type": "string" },
        "time_limit": { "type": "string" },
        "account": { "type": "string" },
        "image": { "type": "string" },
        "gpu": { "type": "boolean" }
      }
    },
    "partition_profile": {
      "type": "object",
      "description": "Declarative hardware/runtime profile for a specific Slurm partition.",
      "additionalProperties": false,
      "properties": {
        "arch": { "type": "string", "enum": ["x86_64", "aarch64"] },
        "gpu_vendor": { "type": "string", "enum": ["nvidia", "amd", "none"] },
        "gpu_memory_gb": { "type": "number", "minimum": 0 },
        "oci_runtime": { "type": "string", "enum": ["crun", "runc"] },
        "userns_mode": { "type": "string" },
        "network_backend": { "type": "string", "enum": ["netavark", "cni"] },
        "vllm_docker_tag": { "type": "string" },
        "vllm_docker_image": { "type": "string" },
        "gpus": { "type": "integer", "minimum": 0 },
        "needs_netavark_switch": { "type": "boolean" },
        "gpu_mem_util_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Ceiling on a model server's --gpu-memory-utilization on this partition (0 = no cap); for GPUs shared with co-located services"
        }
      }
    }
  }
}