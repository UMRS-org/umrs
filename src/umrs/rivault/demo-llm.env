# =============================================================================
# Environment for Demo Always-On LLM Stack (demo-llm.yaml)
# =============================================================================
# Copy and edit as needed. Used with:
#   podman-compose --env-file rivault/demo-llm.env \
#       -f rivault/demo-llm.yaml -f rivault/x_nvidia-override.yaml up -d
# =============================================================================

### MANDATORY
VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
VLLM_PATH_TO_HUGGINGFACE=./models
VLLM_TP=1
VLLM_PP=1
LITELLM_SALT_KEY=demo-salt-key-01
LITELLM_MASTER_KEY=sk-demo-llm

### Network (must match the podman network created before launch)
PRIV_IP1TO3=192.168.5

### Ports exposed on the host
NGINX_LITELLM_DOCKER_PORT=14000
OPENWEBUI_PORT=13000

### NCCL / RCCL shared memory (required by x_nvidia-override.yaml)
VLLM_NCCL_MEM_LIMIT=8G
VLLM_RCCL_MEM_LIMIT=8G

### Optional overrides
VLLM_GPU_MEM_UTIL=0.80
VLLM_DOCKER_TAG=cu130-nightly-aarch64
#LITELLM_DOCKER_TAG=main-stable
#OPENWEBUI_DOCKER_TAG=main
#GENAI_TZ=Asia/Tokyo

