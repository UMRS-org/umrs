# =============================================================================
# Dockerfile.server — Production UMRS server image
# =============================================================================
# Designed for containerized deployment on umrs-front (and later rccs-cloud).
# All config files are mounted at runtime — nothing is baked in.
#
# Key differences from dev Dockerfile:
#   - Includes openssh-client for RemoteSlurmBackend (slurm-remote)
#   - No test data, mock configs, or s3cfg baked in
#   - All config mounted at runtime via volumes
#   - Two-stage build for smaller final image
# =============================================================================

# ─── Stage 1: Build dependencies ─────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build

# System build deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps first (cache-friendly layer)
COPY ./umrs/src/pyproject.toml /build/umrs-src-pyproject.toml
COPY ./r4-contracts/pyproject.toml /build/r4-contracts-pyproject.toml

# Torch wheel index. Default is empty => PyPI => the CUDA build, which is what
# the GPU cluster images want. A CPU-only target (the stand-alone single-host
# deployment, ADR-090) sets this to the CPU index and saves ~1.7 GB of
# nvidia-* wheels that can never execute there:
#   --build-arg TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# Same pattern already used by umrs/deploy/_common/setup_server.sh:110.
ARG TORCH_INDEX_URL=""

# Pre-install heavy deps from pyproject.toml [all] extras
# This layer is cached unless pyproject.toml changes
# torch/torchvision first and SEPARATELY, so TORCH_INDEX_URL can be an
# --index-url (a replacement). --extra-index-url would NOT work here: pip would
# still prefer PyPI's CUDA build by version. This mirrors
# umrs/deploy/_common/setup_server.sh:110, which installs torch on its own.
RUN if [ -n "${TORCH_INDEX_URL}" ]; then \
        pip install --no-cache-dir --index-url "${TORCH_INDEX_URL}" torch torchvision; \
    fi

# The spaCy stack is pinned to the set that ran in production up to
# 2026-10-25 (image 968706f0): preshed 3.0.14, picked up by an unpinned
# rebuild, makes en_core_web_sm fail to load (OverflowError in
# Tokenizer._flush_specials) and the text-embedding experience lost its
# text and text-file modalities. tests/test_server_image_spacy_pin.py.
RUN pip install --no-cache-dir \
    pyzmq boto3 pillow psycopg2-binary asyncpg tabulate pandas jsonschema \
    charset-normalizer requests configparser httpx pyyaml diskcache \
    fastapi "uvicorn[standard]" python-multipart "python-jose[cryptography]" \
    torch torchvision transformers sentence-transformers scikit-learn \
    "spacy==3.8.16" "thinc==8.3.13" "preshed==3.0.13" "cymem==2.0.16" \
    "srsly==2.5.4" "murmurhash==1.0.16" "blis==1.3.3" \
    langchain langchain-community langchain-openai "bentoml>=1.3.0" \
    opencv-python-headless posix_ipc sysv_ipc "rich>=13.0" \
    "pypdf>=4.0" "python-pptx>=1.0" \
    && (python -c "import spacy" && python -m spacy download en_core_web_sm || true)

# ─── Stage 2: Runtime image ──────────────────────────────────────────────────
FROM python:3.11-slim

WORKDIR /app

# Runtime system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-client curl ca-certificates postgresql-client podman \
    && rm -rf /var/lib/apt/lists/*

# Install MinIO Client (mc)
RUN ARCH=$(dpkg --print-architecture) && \
    curl -sSL -o /usr/local/bin/mc \
    "https://dl.min.io/client/mc/release/linux-${ARCH}/mc" \
    && chmod +x /usr/local/bin/mc \
    && mc --version || true

# Copy Python packages from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Bundled text embedder, intfloat/e5-base-v2 at /opt/umrs/models/e5-base-v2
# (maintainer decision 2026-10-09): knowledge embedding and semantic search work
# out of the box. Staged at BUILD time — UMRS never downloads a model at runtime
# — and before the source copy, so source edits do not re-download ~420 MB.
# --build-arg UMRS_BUNDLE_TEXT_EMBEDDER=0 skips it; the site then points
# UMRS_KNOWLEDGE_EMBED_MODEL at a model it stages itself.
ARG UMRS_BUNDLE_TEXT_EMBEDDER=1
COPY ./umrs/src/umrs/knowledge/text_embedder.py /tmp/text_embedder.py
RUN if [ "${UMRS_BUNDLE_TEXT_EMBEDDER}" = "1" ]; then \
        HF_HOME=/tmp/hf python /tmp/text_embedder.py stage && rm -rf /tmp/hf; \
    fi \
    && rm -f /tmp/text_embedder.py

# Copy source code
COPY ./r4-contracts /app/r4-contracts
COPY ./umrs/src /app/umrs-src

# Install packages in editable-like mode (source available at runtime)
RUN pip install --no-cache-dir --no-deps -e /app/r4-contracts \
    && pip install --no-cache-dir --no-deps -e /app/umrs-src

# Create directories for runtime mounts
RUN mkdir -p /etc/umrs /app/logs /run/umrs-ssh \
    && chmod 700 /run/umrs-ssh

# SSH config: disable strict host key checking for automated operation
# (keys are mounted from host, ControlMaster sockets use /run/umrs-ssh/)
RUN mkdir -p /root/.ssh && chmod 700 /root/.ssh \
    && printf 'Host *\n  StrictHostKeyChecking accept-new\n  UserKnownHostsFile /root/.ssh/known_hosts\n  ControlPath /run/umrs-ssh/%%h-%%p\n' \
    > /root/.ssh/config \
    && chmod 600 /root/.ssh/config

ENV PYTHONUNBUFFERED=1
ENV UMRS_CONFIG=/etc/umrs

EXPOSE 8000

# Default entrypoint — conf path overridden via env or compose command
CMD ["python", "/app/umrs-src/server_umrs.py", "-c", "/etc/umrs/conf_umrs.json"]
