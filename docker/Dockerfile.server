# =============================================================================
# Dockerfile.server — Production UMRS server image
# =============================================================================
# Designed for containerized deployment on umrs-front (and later rccs-cloud).
# All config files are mounted at runtime — nothing is baked in.
#
# Key differences from dev Dockerfile:
#   - Includes openssh-client for RemoteSlurmBackend (slurm-remote)
#   - No test data, mock configs, or s3cfg baked in
#   - All config mounted at runtime via volumes
#   - Two-stage build for smaller final image
# =============================================================================

# ─── Stage 1: Build dependencies ─────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build

# System build deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

# Every third-party package comes from the image lock (ADR-100), installed
# with --no-deps so pip resolves nothing on its own. The lock is exported from
# the ai4s-platform workspace uv.lock (umrs[server]) by
#   python scripts/deps/lockctl.py export
# and carries the spaCy model pinned by URL and sha256. Until 2026-10-26 this
# stage pip-installed an unpinned list: the rebuild of 2026-10-25 picked up
# preshed 3.0.14, en_core_web_sm stopped loading and the rccs Text Embedding
# experience lost its text modalities (wave ledger (81)).
COPY ./umrs/docker/server-image/*.lock.txt /build/server-image/

# Torch wheel index. Default is empty => the locked CUDA build from PyPI,
# which is what the GPU cluster images want. A CPU-only target (the stand-alone
# single-host deployment, ADR-090) sets this to the CPU index and saves ~1.7 GB
# of nvidia-* wheels that can never execute there:
#   --build-arg TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# It then installs the LOCKED torch/torchvision versions from that index
# (torch-cpu.lock.txt) and the rest of the lock minus the CUDA-only packages
# (requirements-cpu.lock.txt). --index-url, not --extra-index-url: pip would
# otherwise still prefer PyPI's CUDA build.
ARG TORCH_INDEX_URL=""

RUN if [ -n "${TORCH_INDEX_URL}" ]; then \
        pip install --no-cache-dir --no-deps --index-url "${TORCH_INDEX_URL}" \
            -r /build/server-image/torch-cpu.lock.txt \
        && pip install --no-cache-dir --no-deps -r /build/server-image/requirements-cpu.lock.txt; \
    else \
        pip install --no-cache-dir --no-deps -r /build/server-image/requirements.lock.txt; \
    fi \
    && pip check

# ─── Stage 2: Runtime image ──────────────────────────────────────────────────
FROM python:3.11-slim

WORKDIR /app

# Runtime system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-client curl ca-certificates postgresql-client podman \
    && rm -rf /var/lib/apt/lists/*

# Install MinIO Client (mc)
RUN ARCH=$(dpkg --print-architecture) && \
    curl -sSL -o /usr/local/bin/mc \
    "https://dl.min.io/client/mc/release/linux-${ARCH}/mc" \
    && chmod +x /usr/local/bin/mc \
    && mc --version || true

# Copy Python packages from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Bundled text embedder, intfloat/e5-base-v2 at /opt/umrs/models/e5-base-v2
# (maintainer decision 2026-10-09): knowledge embedding and semantic search work
# out of the box. Staged at BUILD time — UMRS never downloads a model at runtime
# — and before the source copy, so source edits do not re-download ~420 MB.
# --build-arg UMRS_BUNDLE_TEXT_EMBEDDER=0 skips it; the site then points
# UMRS_KNOWLEDGE_EMBED_MODEL at a model it stages itself.
ARG UMRS_BUNDLE_TEXT_EMBEDDER=1
COPY ./umrs/src/umrs/knowledge/text_embedder.py /tmp/text_embedder.py
RUN if [ "${UMRS_BUNDLE_TEXT_EMBEDDER}" = "1" ]; then \
        HF_HOME=/tmp/hf python /tmp/text_embedder.py stage && rm -rf /tmp/hf; \
    fi \
    && rm -f /tmp/text_embedder.py

# Copy source code
COPY ./r4-contracts /app/r4-contracts
COPY ./umrs/src /app/umrs-src

# Install packages in editable-like mode (source available at runtime)
RUN pip install --no-cache-dir --no-deps -e /app/r4-contracts \
    && pip install --no-cache-dir --no-deps -e /app/umrs-src

# Smoke test (ADR-100): the key libraries import and en_core_web_sm loads the
# way the embedding modality loads it; a broken dependency set fails the
# build, so start.sh never swaps in an image that cannot serve. Kept in the
# image for operators: podman run --rm <image> python /opt/umrs/server-image-smoke.py
COPY ./umrs/docker/server-image/smoke.py /opt/umrs/server-image-smoke.py
RUN python /opt/umrs/server-image-smoke.py

# Create directories for runtime mounts
RUN mkdir -p /etc/umrs /app/logs /run/umrs-ssh \
    && chmod 700 /run/umrs-ssh

# SSH config: disable strict host key checking for automated operation
# (keys are mounted from host, ControlMaster sockets use /run/umrs-ssh/)
RUN mkdir -p /root/.ssh && chmod 700 /root/.ssh \
    && printf 'Host *\n  StrictHostKeyChecking accept-new\n  UserKnownHostsFile /root/.ssh/known_hosts\n  ControlPath /run/umrs-ssh/%%h-%%p\n' \
    > /root/.ssh/config \
    && chmod 600 /root/.ssh/config

ENV PYTHONUNBUFFERED=1
ENV UMRS_CONFIG=/etc/umrs

EXPOSE 8000

# Default entrypoint — conf path overridden via env or compose command
CMD ["python", "/app/umrs-src/server_umrs.py", "-c", "/etc/umrs/conf_umrs.json"]
