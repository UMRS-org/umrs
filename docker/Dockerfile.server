# =============================================================================
# Dockerfile.server — Production UMRS server image
# =============================================================================
# Designed for containerized deployment on umrs-front (and later rccs-cloud).
# All config files are mounted at runtime — nothing is baked in.
#
# Key differences from dev Dockerfile:
#   - Includes openssh-client for RemoteSlurmBackend (slurm-remote)
#   - No test data, mock configs, or s3cfg baked in
#   - All config mounted at runtime via volumes
#   - Two-stage build for smaller final image
# =============================================================================

# ─── Stage 1: Build dependencies ─────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build

# System build deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps first (cache-friendly layer)
COPY ./umrs/src/pyproject.toml /build/umrs-src-pyproject.toml
COPY ./r4-contracts/pyproject.toml /build/r4-contracts-pyproject.toml

# Pre-install heavy deps from pyproject.toml [all] extras
# This layer is cached unless pyproject.toml changes
RUN pip install --no-cache-dir \
    pyzmq boto3 pillow psycopg2-binary tabulate pandas jsonschema \
    charset-normalizer requests configparser httpx pyyaml diskcache \
    fastapi "uvicorn[standard]" python-multipart "python-jose[cryptography]" \
    torch torchvision transformers sentence-transformers scikit-learn \
    spacy langchain langchain-community langchain-openai "bentoml>=1.3.0" \
    opencv-python-headless posix_ipc sysv_ipc "rich>=13.0" \
    && (python -c "import spacy" && python -m spacy download en_core_web_sm || true)

# ─── Stage 2: Runtime image ──────────────────────────────────────────────────
FROM python:3.11-slim

WORKDIR /app

# Runtime system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-client curl ca-certificates postgresql-client podman \
    && rm -rf /var/lib/apt/lists/*

# Install MinIO Client (mc)
RUN ARCH=$(dpkg --print-architecture) && \
    curl -sSL -o /usr/local/bin/mc \
    "https://dl.min.io/client/mc/release/linux-${ARCH}/mc" \
    && chmod +x /usr/local/bin/mc \
    && mc --version || true

# Copy Python packages from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy source code
COPY ./r4-contracts /app/r4-contracts
COPY ./umrs/src /app/umrs-src

# Install packages in editable-like mode (source available at runtime)
RUN pip install --no-cache-dir --no-deps -e /app/r4-contracts \
    && pip install --no-cache-dir --no-deps -e /app/umrs-src

# Create directories for runtime mounts
RUN mkdir -p /etc/umrs /app/logs /run/umrs-ssh \
    && chmod 700 /run/umrs-ssh

# SSH config: disable strict host key checking for automated operation
# (keys are mounted from host, ControlMaster sockets use /run/umrs-ssh/)
RUN mkdir -p /root/.ssh && chmod 700 /root/.ssh \
    && printf 'Host *\n  StrictHostKeyChecking accept-new\n  UserKnownHostsFile /root/.ssh/known_hosts\n  ControlPath /run/umrs-ssh/%%h-%%p\n' \
    > /root/.ssh/config \
    && chmod 600 /root/.ssh/config

ENV PYTHONUNBUFFERED=1
ENV UMRS_CONFIG=/etc/umrs

EXPOSE 8000

# Default entrypoint — conf path overridden via env or compose command
CMD ["python", "/app/umrs-src/server_umrs.py", "-c", "/etc/umrs/conf_umrs.json"]
