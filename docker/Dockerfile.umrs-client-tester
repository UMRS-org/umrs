FROM ubuntu:latest

# Install build tools for Python packages with C extensions

RUN apt-get update && apt-get install -y \
    gcc \
    python3 \
    python3-pip \
    python3-venv \
    vim \
    s3cmd \
    netcat-openbsd \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install requests for admin client command
RUN pip3 install --break-system-packages requests

# Create two users
RUN useradd -m user1 && useradd -m user2

# Set up working directory
WORKDIR /client

# Copy client code and requirements (relative to workspace root as build context)
#COPY devs/Infinia_demo /client/Infinia_demo
COPY src /home/user1/src
COPY src /home/user2/src
COPY docker/test_multiuser.sh /client/test_multiuser.sh

COPY requirements-client.txt /client/requirements-client.txt

# Copy per-user config files to their home directories
COPY docker/conf_umrs_user1.json /home/user1/conf_umrs.json
COPY docker/conf_umrs_user2.json /home/user2/conf_umrs.json

# Copy per-user s3cfg files to user home directories
COPY docker/s3cfg_user1 /home/user1/.s3cfg
COPY docker/s3cfg_user2 /home/user2/.s3cfg

# Set proper ownership for user files
RUN chown user1:user1 /home/user1/.s3cfg /home/user1/conf_umrs.json
RUN chown user2:user2 /home/user2/.s3cfg /home/user2/conf_umrs.json

# Make test script executable
RUN chmod +x /client/test_multiuser.sh

# copy the sample data files
COPY data/ /home/user1/data
COPY data/ /home/user2/data

# Install MinIO Client (mc) for correct architecture
RUN ARCH=$(uname -m) && \
    case "$ARCH" in \
      x86_64) ARCH_URL="amd64";; \
      aarch64) ARCH_URL="arm64";; \
      *) echo "Unsupported architecture: $ARCH"; exit 1;; \
    esac && \
    curl -sSL https://dl.min.io/client/mc/release/linux-$ARCH_URL/mc -o /usr/local/bin/mc && chmod +x /usr/local/bin/mc

