# Dockerfile for UMRS API automated test container
FROM python:3.11-slim

WORKDIR /app

# Copy client, test script, and bash test script
COPY ./src/client_umrs_api.py ./client_umrs_api.py
COPY ./docker/test_umrs_api.sh ./test_umrs_api.sh

# Copy examples (including ZeroMQ client) used by the test script
# Copy user configs
COPY ./docker/conf_umrs_user1.json ./conf_umrs_user1.json
COPY ./docker/conf_umrs_user2.json ./conf_umrs_user2.json

# Copy data directory
COPY ./data ./data



# Install dependencies: requests, curl, ca-certificates, jq, and placeholder for umrs-cli
RUN pip install requests pyzmq && \
    apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl jq && \
    rm -rf /var/lib/apt/lists/*
# TODO: Install umrs-cli here if available (e.g., via pip, copy, or other means)

# Copy CA certificate and install as trusted
COPY ./docker/ssl/public.crt /usr/local/share/ca-certificates/umrs_ca.crt
RUN update-ca-certificates

# Set REQUESTS_CA_BUNDLE so requests uses the CA
ENV REQUESTS_CA_BUNDLE=/usr/local/share/ca-certificates/umrs_ca.crt

# Set environment variable for API URL (can be overridden)
#ENV UMRS_API_URL=https://umrs-server:8000

# Run the bash test script on container start
CMD ["/bin/bash", "-c", "chmod +x ./test_umrs_api.sh && ./test_umrs_api.sh"]
