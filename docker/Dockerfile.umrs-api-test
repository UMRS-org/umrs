# Dockerfile for UMRS API automated test container
FROM python:3.11-slim

WORKDIR /app

# Copy requirements first for better layer caching
COPY ./requirements.txt ./requirements.txt

# Copy API client (source) and test script
COPY ./src /app/src
COPY ./docker/test_umrs_api.sh ./test_umrs_api.sh
RUN ln -sf /app/src/client_umrs.py /app/client_umrs.py

# Copy user configs into /app/user_files
COPY ./docker/user_files ./user_files
# Provide docker s3cfg within image as a fallback
COPY ./docker/s3cfg /app/docker/s3cfg

# Copy data directory
COPY ./data ./data



# Install runtime deps for client & test tools
RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential ca-certificates curl jq && \
    pip install --no-cache-dir -r requirements.txt && \
    python -m spacy download en_core_web_sm && \
    apt-get remove -y build-essential && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*
# TODO: Install umrs-cli here if available (e.g., via pip, copy, or other means)

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src

# Set environment variable for API URL (can be overridden)
#ENV UMRS_API_URL=https://umrs-server:8000

# Run the bash test script on container start
CMD ["/bin/bash", "-c", "chmod +x ./test_umrs_api.sh && ./test_umrs_api.sh"]
