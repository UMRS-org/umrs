# =============================================================================
# Per-cluster parameters for ai4s — sourced by deploy/_common/cluster-context.sh
# =============================================================================
# Cluster: AI4S — NVIDIA GB200 NVL4 (aarch64), partitions 1n1gpu..4n4gpu-p.
#
# STATUS: the ai4s host is currently offline. This file, and the shims added
# alongside it, normalise ai4s onto the same structure as rccs/bdrt/octopus so
# that the shared harness scripts are available the moment the host returns.
#
# TOPOLOGY EXCEPTION — ai4s is not yet on the hybrid model:
#   rccs/bdrt/octopus run postgres+minio in podman and the umrs-server NATIVELY
#   on the login node, because the server must invoke sbatch/squeue/scancel.
#   ai4s/docker-compose.yml instead runs postgres, minio, umrs-server AND
#   gateway all as containers (ports 5433/9002/9003/8002/8082, chosen to
#   coexist with rccs-front on the same host).
#
#   Consequently ai4s keeps its own start.sh and stop.sh for now. Pointing them
#   at the shared hybrid implementation would bring up the containerised server
#   via podman-compose and then start a second native server on top of it.
#
#   To finish the migration once ai4s is reachable:
#     1. Reduce ai4s/docker-compose.yml to infra only (postgres + minio),
#        keeping the distinct host ports.
#     2. Run ./setup_server.sh to create the venv.
#     3. Replace start.sh and stop.sh with shims matching the other clusters.
#     4. Verify with ./health_check_server.sh and ./validate_harness.sh.
# =============================================================================

UMRS_CLUSTER="ai4s"
UMRS_SITE_NAME="ai4s"

# Matches site.yaml storage.model_cache_dir.
UMRS_MODEL_ROOT="/work/hps0/home/ea0022/umrs_models"

UMRS_SSH_ALIAS="ai4s"

# ai4s publishes the gateway on 8082 to coexist with rccs-front on the same host.
UMRS_GATEWAY_PORT="8082"

UMRS_CLIENT_PROFILE="ai4s"

UMRS_PARTITIONS="1n1gpu 1n2gpu 1n4gpu 2n4gpu 4n4gpu 4n4gpu-p"
