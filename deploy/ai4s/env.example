# ─────────────────────────────────────────────────────────────
# UMRS AI4S Deployment — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy to .env and fill in secrets before starting.
#
# User accounts across hops:
#   umrs-front:  mnagaso
#   rccs-cloud:  masaru.nagaso (if ProxyJump needed)
#   AI4S login:  ea0022

# PostgreSQL
POSTGRES_USER=umrs
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=umrs_ai4s

# MinIO
MINIO_ROOT_USER=CHANGEME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGEME

# LiteLLM (used by Gateway for auth to compute endpoints)
LITELLM_MASTER_KEY=sk-ll-CHANGEME

# Gateway
RATE_LIMIT_RPS=10

# SSH key path for UMRS container to reach AI4S login node
# Must contain key authorized for ea0022@134.160.189.24
AI4S_SSH_KEY_PATH=~/.ssh/ai4s

# AI4S SSH target (override site.yaml if needed)
# AI4S_SSH_TARGET=134.160.189.24
# AI4S_SSH_USER=ea0022
