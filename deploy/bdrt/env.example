# ─── rccs-cloud UMRS deployment environment ───
#
# Copy this to .env and adjust values as needed.
# podman compose reads .env automatically from the compose-file directory.
# Keep this file for secrets and local overrides. Canonical scheduler/runtime,
# profile, and model-serving defaults live in deploy/rccs-cloud/site.yaml.

# ═══════════════════════════════════════════════════════════════════════════════
# INFRASTRUCTURE (required — set these before first start)
# ═══════════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL ───
POSTGRES_USER=umrs
POSTGRES_PASSWORD=
POSTGRES_DB=umrs_db
# Non-default Postgres port on the host (container always listens on 5432).
#DB_PORT=5432

# ─── MinIO ───
S3_ROOT_USER=
S3_ROOT_PASSWORD=
# Bind MinIO API on the login node.  Compute nodes access MinIO via
# an SSH tunnel (localhost:9000) set up by the Slurm script, so
# external binding is not strictly required.  Set to 0.0.0.0 if you
# also need direct access from other hosts on the network.
S3_BIND=127.0.0.1

# ─── S3 Presigned URL endpoint ───
# Must be reachable from compute nodes (ng-dgx-s, ng-dgx-m*).
# The mini-rivault Slurm script opens an SSH tunnel that forwards
# localhost:9000 on the compute node to the login node's MinIO.
# Use http://localhost:9000 so presigned URLs resolve through the tunnel.
S3_PRESIGN_ENDPOINT=http://localhost:9000

# ─── Vision presigned URL endpoint ───
# BentoML vision runs inside a container on the compute node, so it must use
# the host-gateway alias exposed by the Mini-Rivault Slurm wrapper.
VISION_S3_PRESIGN_ENDPOINT=http://minio-host:19000
VISION_REQUIRE_PRESIGNED_URLS=true

# ═══════════════════════════════════════════════════════════════════════════════
# UMRS SERVER
# ═══════════════════════════════════════════════════════════════════════════════

# ─── ZMQ transport ───
# Control channel port. start.sh detects and kills stale listeners on this port.
#ZMQ_PORT=5555
# Base port for ZMQ data channels (PUSH/PULL).  Must NOT collide with
# VS Code auto-forwarded ports.  The default (5556 = BASE_PORT+1) often
# conflicts with VS Code Remote SSH.  Choose a higher range.
UMRS_DATA_BASE_PORT=5556
# Number of consecutive data ports reserved for per-client queues.
UMRS_DATA_PORT_COUNT=8
# UMRS_TUNNEL_MODE controls *connectivity*, not authentication.
# When true, ZMQ binds to 127.0.0.1 only — set this on HPC clusters where
# ZMQ ports are firewall-blocked and SSH port-forwarding is the only path to
# reach the server.  In direct-connect deployments (k8s, cloud VPC) where ZMQ
# ports are routable, set to false and rely on UMRS_ZMQ_AUTH_TYPE=curve for
# authentication instead.
#UMRS_TUNNEL_MODE=true

# ZMQ transport authentication.
# "none"  — no ZMQ-layer auth (rely on tunnel mode or network isolation)
# "curve" — ZMTP CURVE mutual auth + encryption; recommended for direct-connect
#           deployments where ZMQ ports are network-exposed.
#           Requires UMRS_ZMQ_CURVE_SERVER_PUBLIC_KEY / _SECRET_KEY on the server
#           and matching client key vars on the r4 client side.
#UMRS_ZMQ_AUTH_TYPE=none

# ─── HTTP API ───
# Port for the optional HTTP API surface (admin, model registry, etc.).
#UMRS_HTTP_PORT=8082

# ─── Logging ───
#UMRS_LOG_LEVEL=INFO

# ─── RAG service ───
# Set to "true" to enable the built-in RAG pipeline.
#UMRS_RAG_ENABLE=false

# ─── Orchestrator backend ───
# auto | slurm | kubernetes | compose.  "auto" detects from the environment.
#RIVAULT_ORCHESTRATOR=auto

# ─── Go runtime ───
# Limit Go GC threads (mc/MinIO client, rootlesskit).  Lower values reduce
# CPU contention on shared login nodes.
#GOMAXPROCS=4

# ═══════════════════════════════════════════════════════════════════════════════
# SITE CONFIG & MODEL PATHS
# ═══════════════════════════════════════════════════════════════════════════════

# Optional explicit SiteConfig path. start.sh prefers ~/.config/umrs/site.yaml
# and falls back to deploy/rccs-cloud/site.yaml when unset.
#UMRS_SITE_CONFIG=~/.config/umrs/site.yaml

# Model cache on Lustre — shared between login node and compute nodes.
# The canonical default lives in deploy/rccs-cloud/site.yaml
# (storage.model_cache_dir). Uncomment only to override it locally.
#MODEL_DIR=/lvs0/dne1/rccs-dmp/${USER}/umrs_models

# Hugging Face cache location. Derived from MODEL_DIR by default.
# Override only if your HF cache is separate from the model root.
#HF_HOME=${MODEL_DIR}/hf

# Root directory where `r4 model stage` downloads are placed.
#UMRS_MODEL_STAGING_ROOT=

# Optional model registry allowlist override.
# `start.sh` appends `${HOME}/models/*` automatically so user-scoped model
# registration can work on RCCS (`/home/users/<user>/models/*`). Only override
# this if you need additional site-specific paths.
#MODEL_ALLOWED_PATHS=/shared/models/system/*:/shared/projects/*/models/*:/shared/users/*/models/*:/models/*:/home/*/models/*

# ═══════════════════════════════════════════════════════════════════════════════
# SLURM JOB DEFAULTS
# ═══════════════════════════════════════════════════════════════════════════════

# These override site.yaml's scheduler.slurm.* section when set.
# Commonly tuned per-site; leave commented to use site.yaml values.
#SLURM_PARTITION=gpu
#SLURM_TIME=02:00:00
#SLURM_GPUS=1
#SLURM_CPUS=8
#SLURM_MEM=64G
# Required on some clusters for job accounting.
#SLURM_ACCOUNT=

# Path to the site-specific Slurm wrapper that launches mini-rivault.
# Default: ./serve-model.slurm
# setup_server.sh also creates ~/.config/umrs/rivault_data/serve-model.slurm
# for legacy lookup paths, but deploy/rccs-cloud/start.sh now prefers the
# colocated wrapper unless you explicitly override this variable.
#RIVAULT_SLURM_SCRIPT=./serve-model.slurm

# ═══════════════════════════════════════════════════════════════════════════════
# MINI-RIVAULT ENDPOINT
# ═══════════════════════════════════════════════════════════════════════════════

# Optional overrides for values that normally come from site.yaml.
# Uncomment only when you need to diverge from the canonical rccs-cloud site
# contract for a local experiment or emergency override.

# Port exposed by NGINX on the compute node (LiteLLM behind NGINX).
#RIVAULT_REMOTE_PORT=8001
# LiteLLM authentication key. If empty, serve-model.slurm generates a
# per-job random key and reports it back via the control channel.
#LITELLM_MASTER_KEY=
# How long the orchestrator waits for LiteLLM /v1/models to become ready.
# For long-queue clusters (Slurm) set this to match the expected max queue time.
# Pool endpoints on rccs-cloud use 604800 (7 days) so queued jobs are preserved.
#RIVAULT_STARTUP_TIMEOUT_SEC=600
# Readiness polling timeout — must match or exceed RIVAULT_STARTUP_TIMEOUT_SEC.
#RIVAULT_READINESS_TIMEOUT_SEC=600
# How long the janitor waits before cancelling a stuck PROVISIONING endpoint.
# Jobs with benign Slurm reasons (Resources, Priority, etc.) are preserved longer.
# Set to match RIVAULT_STARTUP_TIMEOUT_SEC on long-queue clusters.
#JANITOR_STUCK_TIMEOUT_SEC=600
# Seconds of idle time before the endpoint is automatically stopped.
#RIVAULT_IDLE_TIMEOUT_SEC=3600

# Compose profiles activated inside mini-rivault.
# Common profiles: harness, vllm, vision, vision-bentoml, litellm-db, egress
# (the profile is named 'egress'; it starts the egress-guard proxy — ADR-040).
#RIVAULT_PROFILES=harness vllm

# Ephemeral port range for dynamically assigned endpoints.
#RIVAULT_PORT_MIN=11434
#RIVAULT_PORT_MAX=11534

# ═══════════════════════════════════════════════════════════════════════════════
# AUTHENTICATION & SECURITY
# ═══════════════════════════════════════════════════════════════════════════════

# ─── JWT signing secret ───
# MUST be set in production. Used by the Gateway and `umrs-server admin token
# generate-jwt` to sign and verify JWTs.  If unset, a dev-only insecure default
# is used and the server logs a warning at startup.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ─── OIDC / JWKS (RS256) ───
# When set, UMRS validates JWTs against this JWKS endpoint instead of
# JWT_SECRET.  Required for Okta/OIDC deployments — must match the
# Gateway's JWT_JWKS_URL so both components accept the same tokens.
# Example: https://your-org.okta.com/oauth2/default/v1/keys
#JWT_JWKS_URL=

# ─── Auth mode ───
# mvp (default): JWT project/user claims are informational; API proceeds without
#   strict verification.  Suitable for single-user or development deployments.
# strict: every API request must carry a valid JWT; project and user are
#   enforced against the user store on each request.
#UMRS_AUTH_MODE=mvp

# ─── JWT token default TTL ───
# Default validity in days for JWTs issued by `umrs-server admin token
# generate-jwt`.  Individual tokens can override this with --days.
# Short TTLs (7-14 days) are recommended for production.
#UMRS_JWT_DEFAULT_DAYS=30

# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE CONNECTION
# ═══════════════════════════════════════════════════════════════════════════════

# Primary Postgres DSN for the HTTP API (routing, checkpoints, RAG, etc.).
# Either UMRS_DB_DSN or DATABASE_URL is accepted; UMRS_DB_DSN takes precedence.
# When unset, UMRS builds the DSN from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB.
#UMRS_DB_DSN=postgresql://umrs:password@localhost:5432/umrs_db
#DATABASE_URL=postgresql://umrs:password@localhost:5432/umrs_db

# Separate Postgres DSN for the model registry (defaults to the primary DSN).
#UMRS_REGISTRY_POSTGRES_DSN=

# Force the registry storage backend.
# auto (default): postgres if DSN available, else filesystem.
# Values: auto | postgres | filesystem
#UMRS_REGISTRY_BACKEND=auto

# ═══════════════════════════════════════════════════════════════════════════════
# GATEWAY & HTTP SIDECAR
# ═══════════════════════════════════════════════════════════════════════════════

# LiteLLM key used by the Gateway when proxying /gw/llm/* requests.
# Normally the same as LITELLM_MASTER_KEY.  Set GATEWAY_LITELLM_SERVICE_KEY
# only when you want to use a separate service-account key for gateway→LiteLLM.
#GATEWAY_LITELLM_SERVICE_KEY=

# Gateway mode on the compute node side.
# nginx (default): NGINX fronts LiteLLM on the compute node.
# passthrough: LiteLLM is accessed directly (no NGINX in the mini-rivault).
#GATEWAY_MODE=nginx

# Environment label written into gateway audit log entries.
# Values: development (default) | staging | production
#GATEWAY_ENVIRONMENT=development

# Bind host for the embedded HTTP sidecar (admin API, model registry, gateway).
# Defaults to 0.0.0.0.  Set to 127.0.0.1 when a reverse proxy (NGINX) sits
# in front so the port is not directly reachable from the network.
#UMRS_HTTP_HOST=0.0.0.0

# Disable the HTTP sidecar entirely (ZMQ-only or headless deployments).
#UMRS_HTTP_SIDECAR_ENABLED=true

# ═══════════════════════════════════════════════════════════════════════════════
# ADVANCED TUNING
# ═══════════════════════════════════════════════════════════════════════════════

# Disable the background job scheduler (reconciler, TTL reaper, ghost pruner).
# Useful for read-only or replay-mode UMRS instances.
#UMRS_SCHEDULER_ENABLED=true

# Transport layer used by internal ops / health-check probes.
# http (default) | zmq
#UMRS_TRANSPORT=http

# Override the output directory for job artefacts (logs, result JSON).
# Defaults to a sub-directory inside the UMRS config directory.
#RIVAULT_OUTPUT_DIR=

# Timeout in seconds for synchronous Slurm CLI calls (squeue, sbatch, scancel).
# Increase on clusters where the Slurm scheduler is slow to respond.
#SLURM_CLI_TIMEOUT_SEC=15

# Seconds to wait for a running endpoint container to exit gracefully before
# force-killing it during stop / teardown.
#RIVAULT_GRACEFUL_STOP_TIMEOUT=20

# Object store (ADR-055): SeaweedFS everywhere; MinIO reachable only via
# S3_BACKEND=minio for support/rescue. Image override for air-gapped mirrors:
# S3_IMAGE=docker.io/chrislusf/seaweedfs:4.47
