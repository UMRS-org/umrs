# =============================================================================
# Per-cluster parameters for bdrt — sourced by deploy/_common/cluster-context.sh
# =============================================================================
# Cluster: BDRT, GB10 Grace-Blackwell DGX-Spark nodes on nimbus-0.
# Topology: hybrid — postgres/minio in podman, umrs-server native.

UMRS_CLUSTER="bdrt"
UMRS_SITE_NAME="bdrt"

# bdrt has no /lvs0 shared filesystem; models live under the user's home.
UMRS_MODEL_ROOT="/home/${USER}/umrs_models"

UMRS_SSH_ALIAS="nimbus-0"

# 8080 is occupied by the system PKI service on nimbus-0.
UMRS_GATEWAY_PORT="18080"

UMRS_CLIENT_PROFILE="bdrt"

UMRS_PARTITIONS="spark spark-double edge-double"
