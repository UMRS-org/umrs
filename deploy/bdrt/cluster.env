# =============================================================================
# Per-cluster parameters for bdrt — sourced by deploy/_common/cluster-context.sh
# =============================================================================
# Cluster: BDRT, GB10 Grace-Blackwell DGX-Spark nodes on nimbus-0.
# Topology: hybrid — postgres/minio in podman, umrs-server native.

UMRS_CLUSTER="bdrt"
UMRS_SITE_NAME="bdrt"

# bdrt has no /lvs0 shared filesystem; models live under the user's home.
UMRS_MODEL_ROOT="/home/${USER}/umrs_models"

UMRS_SSH_ALIAS="nimbus-0"

# 8080 is occupied by the system PKI service on nimbus-0.
UMRS_GATEWAY_PORT="18080"

UMRS_CLIENT_PROFILE="bdrt"

UMRS_PARTITIONS="spark spark-double edge-double"

# Sizing + per-deployment vLLM runtime overrides for single-endpoint
# provisions. pool-bdrt-step.yaml is the battle-tested roster: it carries the
# 2-node edge-double entries for laguna-s-2.1-fp8, hy3-nvfp4 and glm-5.2,
# each with its own VLLM_DOCKER_IMAGE (pinned ARM64 vLLM build), tool and
# reasoning parsers, and — for Laguna — the dflash patch bind-mount that the
# howtospark recipe applies to the vLLM source tree.
UMRS_PROVISION_ROSTER="${UMRS_CLUSTER_DIR}/pool-bdrt-step.yaml"
