# =============================================================================
# Per-cluster parameters for octopus — sourced by _common/cluster-context.sh
# =============================================================================
# Cluster: RIKEN octopus — AMD Instinct MI300X (ROCm) and NVIDIA H200 (CUDA),
# both x86_64.
# Topology: hybrid — postgres/minio in podman, umrs-server native.
#
# NOTE: octopus's per-cluster script copies were cloned from bdrt and never
# corrected. Consolidating them surfaced four wrong values, fixed here:
#   - model root pointed at RCCS's /lvs0/dne1/rccs-dmp (octopus has no /lvs0)
#   - ssh_tunnel.sh defaulted to bdrt's login node nimbus-0
#   - ssh_tunnel.sh used bdrt's gateway port 18080
#   - setup_client.sh wrote a connection profile named "bdrt"
# See ADR-019.

UMRS_CLUSTER="octopus"
UMRS_SITE_NAME="octopus"

# Matches site.yaml storage.model_cache_dir (/home/${USER}/umrs_models/hf).
UMRS_MODEL_ROOT="/home/${USER}/umrs_models"

UMRS_SSH_ALIAS="octopus"
UMRS_GATEWAY_PORT="8080"
UMRS_CLIENT_PROFILE="octopus"

UMRS_PARTITIONS="mi300x h200"
