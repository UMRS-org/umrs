# =============================================================================
# Per-cluster parameters for rccs — sourced by deploy/_common/cluster-context.sh
# =============================================================================
# Cluster: RIKEN RCCS cloud, NVIDIA GB10 Blackwell (aarch64).
# Topology: hybrid — postgres/minio in podman, umrs-server native on the login
# node so it can call sbatch/squeue/scancel.

UMRS_CLUSTER="rccs"

# site.yaml still carries the historical name "rccs-cloud"; health_check_server
# asserts against this exact value.
UMRS_SITE_NAME="rccs-cloud"

# Fallback model root. site.yaml storage.model_cache_dir wins when loadable.
UMRS_MODEL_ROOT="/lvs0/dne1/rccs-dmp/${USER}/umrs_models"

UMRS_SSH_ALIAS="rccs-cloud"
UMRS_GATEWAY_PORT="8080"
UMRS_CLIENT_PROFILE="rccs-cloud"

# Partitions swept by harness_probe.sh (broader than site.yaml's scheduler
# default — the probe deliberately tests every partition the site exposes).
UMRS_PARTITIONS="ng-dgx-m0 ng-dgx-m1 ng-dgx-m2 ng-dgx-m3 a100 ai-h100l ai-h200-brc ai-l40s qc-a100 qc-gh200 qc-mi210 qc-mi250 qc-pvc fx700 genoa mi100 fs-mi300a fs-mi300x r340"
