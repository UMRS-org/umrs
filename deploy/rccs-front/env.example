# ─────────────────────────────────────────────────────────────
# UMRS Front-End Server — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy to .env and fill in secrets before starting.

# PostgreSQL
POSTGRES_USER=umrs
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=umrs_db

# MinIO
S3_ROOT_USER=CHANGEME_S3_USER
S3_ROOT_PASSWORD=CHANGEME

# LiteLLM (used by Gateway for auth to compute endpoints)
LITELLM_MASTER_KEY=sk-ll-CHANGEME

# Gateway
RATE_LIMIT_RPS=10

# SSH key path for UMRS container to reach login node
# The container mounts this as /home/umrs/.ssh (read-only)
SSH_KEY_PATH=~/.ssh

# Optional: override SSH target (default from site.yaml: rccs-cloud)
# SSH_TARGET=rccs-cloud

# ═══════════════════════════════════════════════════════════════════════════════
# AUTHENTICATION & SECURITY
# ═══════════════════════════════════════════════════════════════════════════════

# ─── JWT signing secret ───
# MUST be set in production. Used by the Gateway and `umrs-server admin token
# generate-jwt` to sign and verify JWTs.  If unset, a dev-only insecure default
# is used and the server logs a warning at startup.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ─── OIDC / JWKS (RS256) ───
# When set, UMRS validates JWTs against this JWKS endpoint instead of
# JWT_SECRET.  Required for Okta/OIDC deployments — must match the
# Gateway's JWT_JWKS_URL so both components accept the same tokens.
# Example: https://your-org.okta.com/oauth2/default/v1/keys
#JWT_JWKS_URL=

# ─── Auth mode ───
# mvp (default): JWT project/user claims are informational; API proceeds without
#   strict verification.  Suitable for single-user or development deployments.
# strict: every API request must carry a valid JWT; project and user are
#   enforced against the user store on each request.
#UMRS_AUTH_MODE=mvp

# ─── JWT token default TTL ───
# Default validity in days for JWTs issued by `umrs-server admin token
# generate-jwt`.  Individual tokens can override this with --days.
# Short TTLs (7-14 days) are recommended for production.
#UMRS_JWT_DEFAULT_DAYS=30

# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE CONNECTION
# ═══════════════════════════════════════════════════════════════════════════════

# Primary Postgres DSN for the HTTP API (routing, checkpoints, RAG, etc.).
# Either UMRS_DB_DSN or DATABASE_URL is accepted; UMRS_DB_DSN takes precedence.
# When unset, UMRS builds the DSN from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB.
#UMRS_DB_DSN=postgresql://umrs:password@localhost:5432/umrs_db
#DATABASE_URL=postgresql://umrs:password@localhost:5432/umrs_db

# Separate Postgres DSN for the model registry (defaults to the primary DSN).
#UMRS_REGISTRY_POSTGRES_DSN=

# Force the registry storage backend.
# auto (default): postgres if DSN available, else filesystem.
# Values: auto | postgres | filesystem
#UMRS_REGISTRY_BACKEND=auto

# ═══════════════════════════════════════════════════════════════════════════════
# GATEWAY & HTTP SIDECAR
# ═══════════════════════════════════════════════════════════════════════════════

# LiteLLM key used by the Gateway when proxying /gw/llm/* requests.
# Normally the same as LITELLM_MASTER_KEY.  Set GATEWAY_LITELLM_SERVICE_KEY
# only when you want to use a separate service-account key for gateway→LiteLLM.
#GATEWAY_LITELLM_SERVICE_KEY=

# Gateway mode on the compute node side.
# nginx (default): NGINX fronts LiteLLM on the compute node.
# passthrough: LiteLLM is accessed directly (no NGINX in the mini-rivault).
#GATEWAY_MODE=nginx

# Environment label written into gateway audit log entries.
# Values: development (default) | staging | production
#GATEWAY_ENVIRONMENT=development

# Bind host for the embedded HTTP sidecar (admin API, model registry, gateway).
# Defaults to 0.0.0.0.  Set to 127.0.0.1 when a reverse proxy (NGINX) sits
# in front so the port is not directly reachable from the network.
#UMRS_HTTP_HOST=0.0.0.0

# Disable the HTTP sidecar entirely (ZMQ-only or headless deployments).
#UMRS_HTTP_SIDECAR_ENABLED=true

# ═══════════════════════════════════════════════════════════════════════════════
# ADVANCED TUNING
# ═══════════════════════════════════════════════════════════════════════════════

# Disable the background job scheduler (reconciler, TTL reaper, ghost pruner).
# Useful for read-only or replay-mode UMRS instances.
#UMRS_SCHEDULER_ENABLED=true

# Transport layer used by internal ops / health-check probes.
# http (default) | zmq
#UMRS_TRANSPORT=http

# Override the output directory for job artefacts (logs, result JSON).
# Defaults to a sub-directory inside the UMRS config directory.
#RIVAULT_OUTPUT_DIR=

# Timeout in seconds for synchronous Slurm CLI calls (squeue, sbatch, scancel).
# Increase on clusters where the Slurm scheduler is slow to respond.
#SLURM_CLI_TIMEOUT_SEC=15

# Seconds to wait for a running endpoint container to exit gracefully before
# force-killing it during stop / teardown.
#RIVAULT_GRACEFUL_STOP_TIMEOUT=20

# Object store (ADR-055): SeaweedFS everywhere; MinIO reachable only via
# S3_BACKEND=minio for support/rescue. Image override for air-gapped mirrors:
# S3_IMAGE=docker.io/chrislusf/seaweedfs:4.47
