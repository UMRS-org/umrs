# ─── rccs-cloud UMRS deployment environment ───
#
# Copy this to .env and adjust values as needed.
# podman compose reads .env automatically from the compose-file directory.

# ─── PostgreSQL ───
POSTGRES_USER=umrs
POSTGRES_PASSWORD=umrs_rccs
POSTGRES_DB=umrs_db

# ─── MinIO ───
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Bind MinIO API to all interfaces so compute nodes can reach it
# via presigned URLs.  Change to 127.0.0.1 to restrict to localhost only.
MINIO_BIND=0.0.0.0

# ─── S3 Presigned URL endpoint ───
# Must be reachable from compute nodes (dgx-s, dgx-m*).
# Use the login node hostname or IP.  The server generates presigned
# GET/PUT URLs with this base so that compute-node workers can
# download inputs and upload results without S3 credentials.
S3_PRESIGN_ENDPOINT=http://rccs-cloud:9000

# ─── Model cache on Lustre ───
# Shared filesystem accessible from both login and compute nodes.
MODEL_DIR=/lvs0/rccs-dmp/mnagaso/umrs_models
