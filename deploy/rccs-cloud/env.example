# ─── rccs-cloud UMRS deployment environment ───
#
# Copy this to .env and adjust values as needed.
# podman compose reads .env automatically from the compose-file directory.
# Keep this file for secrets and local overrides. Canonical scheduler/runtime,
# profile, and model-serving defaults live in deploy/rccs-cloud/site.yaml.

# ═══════════════════════════════════════════════════════════════════════════════
# INFRASTRUCTURE (required — set these before first start)
# ═══════════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL ───
POSTGRES_USER=umrs
POSTGRES_PASSWORD=
POSTGRES_DB=umrs_db
# Non-default Postgres port on the host (container always listens on 5432).
#DB_PORT=5432

# ─── MinIO ───
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Bind MinIO API on the login node.  Compute nodes access MinIO via
# an SSH tunnel (localhost:9000) set up by the Slurm script, so
# external binding is not strictly required.  Set to 0.0.0.0 if you
# also need direct access from other hosts on the network.
MINIO_BIND=127.0.0.1

# ─── S3 Presigned URL endpoint ───
# Must be reachable from compute nodes (ng-dgx-s, ng-dgx-m*).
# The mini-rivault Slurm script opens an SSH tunnel that forwards
# localhost:9000 on the compute node to the login node's MinIO.
# Use http://localhost:9000 so presigned URLs resolve through the tunnel.
S3_PRESIGN_ENDPOINT=http://localhost:9000

# ─── Vision presigned URL endpoint ───
# BentoML vision runs inside a container on the compute node, so it must use
# the host-gateway alias exposed by the Mini-Rivault Slurm wrapper.
VISION_S3_PRESIGN_ENDPOINT=http://minio-host:19000
VISION_REQUIRE_PRESIGNED_URLS=true

# ═══════════════════════════════════════════════════════════════════════════════
# UMRS SERVER
# ═══════════════════════════════════════════════════════════════════════════════

# ─── ZMQ transport ───
# Control channel port. start.sh detects and kills stale listeners on this port.
#ZMQ_PORT=5555
# Base port for ZMQ data channels (PUSH/PULL).  Must NOT collide with
# VS Code auto-forwarded ports.  The default (5556 = BASE_PORT+1) often
# conflicts with VS Code Remote SSH.  Choose a higher range.
UMRS_DATA_BASE_PORT=5556
# Number of consecutive data ports reserved for per-client queues.
UMRS_DATA_PORT_COUNT=8
# When true, ZMQ binds to 127.0.0.1 only; clients reach the server via
# SSH tunnel.  Required on RCCS for security.
#UMRS_TUNNEL_MODE=true

# ─── HTTP API ───
# Port for the optional HTTP API surface (admin, model registry, etc.).
#UMRS_HTTP_PORT=8082

# ─── Logging ───
#UMRS_LOG_LEVEL=INFO

# ─── RAG service ───
# Set to "true" to enable the built-in RAG pipeline.
#UMRS_RAG_ENABLE=false

# ─── Orchestrator backend ───
# auto | slurm | kubernetes | compose.  "auto" detects from the environment.
#RIVAULT_ORCHESTRATOR=auto

# ─── Go runtime ───
# Limit Go GC threads (mc/MinIO client, rootlesskit).  Lower values reduce
# CPU contention on shared login nodes.
#GOMAXPROCS=4

# ═══════════════════════════════════════════════════════════════════════════════
# SITE CONFIG & MODEL PATHS
# ═══════════════════════════════════════════════════════════════════════════════

# Optional explicit SiteConfig path. start.sh prefers ~/.config/umrs/site.yaml
# and falls back to deploy/rccs-cloud/site.yaml when unset.
#UMRS_SITE_CONFIG=~/.config/umrs/site.yaml

# Model cache on Lustre — shared between login node and compute nodes.
# The canonical default lives in deploy/rccs-cloud/site.yaml
# (storage.model_cache_dir). Uncomment only to override it locally.
#MODEL_DIR=/lvs0/dne1/rccs-dmp/${USER}/umrs_models

# Hugging Face cache location. Derived from MODEL_DIR by default.
# Override only if your HF cache is separate from the model root.
#HF_HOME=${MODEL_DIR}/hf

# Root directory where `r4 model stage` downloads are placed.
#UMRS_MODEL_STAGING_ROOT=

# Optional model registry allowlist override.
# `start.sh` appends `${HOME}/models/*` automatically so user-scoped model
# registration can work on RCCS (`/home/users/<user>/models/*`). Only override
# this if you need additional site-specific paths.
#MODEL_ALLOWED_PATHS=/shared/models/system/*:/shared/projects/*/models/*:/shared/users/*/models/*:/models/*:/home/*/models/*

# ═══════════════════════════════════════════════════════════════════════════════
# SLURM JOB DEFAULTS
# ═══════════════════════════════════════════════════════════════════════════════

# These override site.yaml's scheduler.slurm.* section when set.
# Commonly tuned per-site; leave commented to use site.yaml values.
#SLURM_PARTITION=gpu
#SLURM_TIME=02:00:00
#SLURM_GPUS=1
#SLURM_CPUS=8
#SLURM_MEM=64G
# Required on some clusters for job accounting.
#SLURM_ACCOUNT=

# Path to the site-specific Slurm wrapper that launches mini-rivault.
# Default: ./serve-model.slurm
# setup_server.sh also creates ~/.config/umrs/rivault_data/serve-model.slurm
# for legacy lookup paths, but deploy/rccs-cloud/start.sh now prefers the
# colocated wrapper unless you explicitly override this variable.
#RIVAULT_SLURM_SCRIPT=./serve-model.slurm

# ═══════════════════════════════════════════════════════════════════════════════
# MINI-RIVAULT ENDPOINT
# ═══════════════════════════════════════════════════════════════════════════════

# Optional overrides for values that normally come from site.yaml.
# Uncomment only when you need to diverge from the canonical rccs-cloud site
# contract for a local experiment or emergency override.

# Port exposed by NGINX on the compute node (LiteLLM behind NGINX).
#RIVAULT_REMOTE_PORT=8001
# LiteLLM authentication key. If empty, serve-model.slurm generates a
# per-job random key and reports it back via the control channel.
#LITELLM_MASTER_KEY=
# How long the orchestrator waits for LiteLLM /v1/models to become ready.
#RIVAULT_STARTUP_TIMEOUT_SEC=600
# Seconds of idle time before the endpoint is automatically stopped.
#RIVAULT_IDLE_TIMEOUT_SEC=3600

# Compose profiles activated inside mini-rivault.
# Common profiles: harness, vllm, vision, litellm-db, egress-guard.
#RIVAULT_PROFILES=harness vllm

# Ephemeral port range for dynamically assigned endpoints.
#RIVAULT_PORT_MIN=11434
#RIVAULT_PORT_MAX=11534
