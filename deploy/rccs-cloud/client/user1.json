          },
          "model": {
            "model_name": "intfloat/e5-base-v2",
            "vector_size": "768",
            "model_type": "TransformerEncoder"
          },
          "sql": {
            "store_embeddings": "yes",
            "table_name": "text_file",
            "meta_data": [
              { "name": "keywords", "type": "TEXT" }
            ]
          }
        },
        {
          "modality_name": "image",
