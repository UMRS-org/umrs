{
  "name": "rccs-cloud",
  "mode": "ssh_tunnel",
  "zmq": {
    "host": "127.0.0.1",
    "control_port": 5555,
    "data_base_port": 5556,
    "data_port_range": {
      "start": 5556,
      "end": 5563
    },
    "tunnel_mode": true,
    "health_check_timeout_ms": 15000
  },
  "services": {
    "minio_url": "http://127.0.0.1:9000",
    "rag_url": "http://127.0.0.1:8081"
  },
  "ssh": {
    "host": "rccs-cloud",
    "command_hint": "cd deploy/rccs-cloud && ./ssh_tunnel.sh",
