# ─── Frontend → multi-HPC deployment environment (TEMPLATE) ───
#
# Copy to .env and fill in secrets + per-cluster ports. `podman compose` reads
# .env automatically. Per-cluster scheduler/SSH defaults live in the
# site.cluster-*.yaml files.

# ═══════════════════════════════════════════════════════════════════════════
# SHARED INFRASTRUCTURE (required)
# ═══════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL (one DB per cluster) ───
POSTGRES_USER=umrs
POSTGRES_PASSWORD=              # REQUIRED
POSTGRES_PORT=5432
POSTGRES_DB_CLUSTER_A=front_cluster_a
POSTGRES_DB_CLUSTER_B=front_cluster_b

# ─── MinIO (shared object store) ───
MINIO_ROOT_USER=                # REQUIRED
MINIO_ROOT_PASSWORD=            # REQUIRED
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Bind 0.0.0.0 only on trusted cluster paths; restrict with a firewall.
MINIO_BIND=0.0.0.0
S3_BUCKET=r4-data
S3_USE_SSL=false

# ═══════════════════════════════════════════════════════════════════════════
# PER-CLUSTER PORTS (distinct sets so servers don't collide on host networking)
# ═══════════════════════════════════════════════════════════════════════════

# ─── cluster A ───
UMRS_A_PORT=8000                # HTTP API (gateway upstream)
UMRS_A_ZMQ_PORT=50090           # ZMQ control
UMRS_A_DATA_PORT_RANGE=50091-50098

# ─── cluster B ───
UMRS_B_PORT=8002
UMRS_B_ZMQ_PORT=50100
UMRS_B_DATA_PORT_RANGE=50101-50108

# Bind address for the UMRS HTTP API inside each server container.
UMRS_HTTP_HOST=0.0.0.0

# Cap Go runtime threads on the shared frontend host.
GOMAXPROCS=4
