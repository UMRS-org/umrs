# ─── Login-node UMRS deployment environment (TEMPLATE) ───
#
# Copy to .env and fill in secrets. `podman compose` reads .env automatically.
# Canonical scheduler/runtime/model defaults live in site.yaml — keep this file
# for secrets and host-local overrides only.

# ═══════════════════════════════════════════════════════════════════════════
# INFRASTRUCTURE (required)
# ═══════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL ───
POSTGRES_USER=umrs
POSTGRES_PASSWORD=            # REQUIRED — set a strong password
POSTGRES_DB=umrs_db
#DB_PORT=5432                 # host port (container always listens on 5432)

# ─── MinIO ───
S3_ROOT_USER=             # REQUIRED
S3_ROOT_PASSWORD=         # REQUIRED
# Loopback by default; compute nodes reach MinIO via SSH tunnel to login:9000.
# Set 0.0.0.0 only if other trusted hosts must reach it directly.
S3_BIND=127.0.0.1

# ─── S3 presigned URL endpoint ───
# Must resolve from compute nodes. With the SSH tunnel login:9000, keep this
# as localhost:9000 so presigned URLs work on the compute side.
S3_PRESIGN_ENDPOINT=http://localhost:9000

# ═══════════════════════════════════════════════════════════════════════════
# UMRS SERVER TRANSPORT
# ═══════════════════════════════════════════════════════════════════════════

# ─── ZMQ transport ───
#ZMQ_PORT=5555                # control channel
UMRS_DATA_BASE_PORT=5556      # base of the PUSH/PULL data-port range
UMRS_DATA_PORT_COUNT=8

# Connectivity mode (NOT auth):
#   true  → bind ZMQ to 127.0.0.1 only; clients reach it over SSH tunnels
#   false → ZMQ ports routable; pair with UMRS_ZMQ_AUTH_TYPE=curve
UMRS_TUNNEL_MODE=true

# ZMQ auth: none | curve
#UMRS_ZMQ_AUTH_TYPE=none

# ─── HTTP API ───
#UMRS_HTTP_PORT=8082
#UMRS_LOG_LEVEL=INFO

# ─── Orchestrator backend: auto | slurm | kubernetes | compose ───
#RIVAULT_ORCHESTRATOR=auto

# Cap Go runtime threads on shared login nodes (podman/minio client).
GOMAXPROCS=4

# ═══════════════════════════════════════════════════════════════════════════
# SITE CONFIG
# ═══════════════════════════════════════════════════════════════════════════
# start.sh prefers ~/.config/umrs/site.yaml and falls back to ./site.yaml.
#UMRS_SITE_CONFIG=~/.config/umrs/site.yaml
